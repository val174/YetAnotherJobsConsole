#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает массив параметров регламентного задания по имени объекта метаданных.
//
// Параметры:
//   ИмяМетаданных - Строка - полное имя объекта метаданных регламентного задания
//
// Возвращаемое значение:
//   Массив из Структура - содержащий структуры параметров регламентного задания. Ключи структуры см. НовыеПараметрыРегламентногоЗадания() 
//
Функция ПараметрыРегламентногоЗадания(Знач ИмяМетаданных) Экспорт
	
	ПараметрыЗадания = Новый Массив; // Массив из Структура
	
	Если ИмяМетаданных = "ЗаданиеСПараметрами" Тогда
		ДобавитьПараметрВСписок(ПараметрыЗадания, "Параметр1", "Структура");
		ДобавитьПараметрВСписок(ПараметрыЗадания, "Параметр2", "Массив");
	КонецЕсли;
	
	Возврат ПараметрыЗадания;
	
КонецФункции

// Создает структуру с настройками консоли регламентных заданий,
// содержащую параметры подключения, автообновления и пользовательские предпочтения.
//
// Возвращаемое значение:
//   Структура:
//     * ИмяМодуляРегламентныхЗаданий - Строка - имя общего модуля регламентных заданий
//     * ПрефиксМетаданных - Строка - префикс для идентификации метаданных
//     * ПрефиксИмениПользователяРЗ - Строка - префикс для имен пользователей регламентных заданий
//     * РазрешитьДобавлениеПользователейРегламентныхЗаданий - Булево - признак добавления пользователей
//     * РассчитыватьДатуСледующегоЗапускаРегламентногоЗадания - Булево - признак расчета даты следующего запуска
//     * Избранное - Массив из Строка - список избранных регламентных заданий
//
Функция НовыеНастройкиКонсоли() Экспорт
	
	НастройкиКонсоли = Новый Структура;
	
	НастройкиКонсоли.Вставить("ИмяМодуляРегламентныхЗаданий", "");
	НастройкиКонсоли.Вставить("ПрефиксМетаданных", "");
	НастройкиКонсоли.Вставить("ПрефиксИмениПользователяРЗ", "");
	НастройкиКонсоли.Вставить("РазрешитьДобавлениеПользователейРегламентныхЗаданий", Ложь);
	НастройкиКонсоли.Вставить("РассчитыватьДатуСледующегоЗапускаРегламентногоЗадания", Ложь);
	НастройкиКонсоли.Вставить("Избранное", Новый Массив);
	
	Возврат НастройкиКонсоли;
	
КонецФункции

// Возвращает ключ объекта внешней обработки, используемый для хранения настроек и идентификации в подсистемах.
//
// Возвращаемое значение:
//  Строка - постоянный ключ объекта "КонсольРегламентныхИФоновыхЗаданий".
//
Функция КлючОбъекта() Экспорт
	
	Возврат НСтр("ru = 'КонсольРегламентныхИФоновыхЗаданий'; en = 'ScheduledAndBackgroundJobsConsole'");
	
КонецФункции

// Возвращает ключ настроек консоли регламентных и фоновых заданий.
//
// Возвращаемое значение:
//   Строка - ключ настроек консоли заданий
//
Функция КлючНастроек() Экспорт
	
	Возврат НСтр("ru = 'Настройки консоли заданий'; en = 'Jobs console settings'");
	
КонецФункции

// Возвращает сведения о внешней обработке для регистрации в справочнике
// ДополнительныеОтчетыИОбработки библиотеки стандартных подсистем.
//
// Параметры:
//   ВерсияБСП - Строка - версия библиотеки стандартных подсистем.
//
// Возвращаемое значение:
//   Структура - сведения о внешней обработке, см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке().
//
Функция СведенияОВнешнейОбработке(ВерсияБСП = "") Экспорт
	
	Сведения = Новый Структура;
	Сведения.Вставить("Вид", "ДополнительнаяОбработка");
	Сведения.Вставить("Версия", "1.0.0.1");
	Сведения.Вставить("Наименование", НСтр("ru = 'Консоль регламентных и фоновых заданий'"));
	Сведения.Вставить("БезопасныйРежим", Ложь);
	Сведения.Вставить("Информация", НСтр("ru = 'Просмотр и управление регламентными и фоновыми заданиями.'"));
	Сведения.Вставить("ВерсияБСП", ВерсияБСП);
	Сведения.Вставить("Назначение", Новый Массив);
	Сведения.Вставить("Разрешения", Новый Массив);
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Скрыть", Новый ОписаниеТипов("Булево"));
	
	Команда = ТаблицаКоманд.Добавить();
	Команда.Представление = НСтр("ru = 'Консоль регламентных и фоновых заданий'");
	Команда.Идентификатор = "ОткрытьКонсоль";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;
	
	Сведения.Вставить("Команды", ТаблицаКоманд);
	
	Возврат Сведения;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет параметр рег. задания в список
//
// Параметры:
//  ПараметрыЗадания	 - Массив из Структура - массив структур параметров рег. задания см. НовыеПараметрыРегламентногоЗадания()
//  ИмяПараметра		 - Строка - имя параметра
//  ТипПараметра		 - Строка - строкове представление типа параметра
//  ЗначениеПоУмолчанию	 - Произвольный - значение параметра по-умолчанию
//
Процедура ДобавитьПараметрВСписок(ПараметрыЗадания, Знач ИмяПараметра, Знач ТипПараметра, Знач ЗначениеПоУмолчанию = Неопределено)
	
	СтруктураПараметра = НовыеПараметрыРегламентногоЗадания();
	СтруктураПараметра.Имя = ИмяПараметра;
	СтруктураПараметра.Тип = ТипПараметра;
	СтруктураПараметра.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
	
	ПараметрыЗадания.Добавить(СтруктураПараметра);
	
КонецПроцедуры

// Возвращает структуру с параметрами для создания регламентного задания.
//
// Возвращаемое значение:
//   Структура:
//     * Имя - Строка - наименование параметра
//     * Тип - Строка - строковое представление типа значения
//     * ЗначениеПоУмолчанию - Произвольный, Неопределено - значение по умолчанию для параметра
//
Функция НовыеПараметрыРегламентногоЗадания()
	
	СтруктураПараметра = Новый Структура;
	СтруктураПараметра.Вставить("Имя", "");
	СтруктураПараметра.Вставить("Тип", "");
	СтруктураПараметра.Вставить("ЗначениеПоУмолчанию", Неопределено);
	
	Возврат СтруктураПараметра;
	
КонецФункции

#КонецОбласти

#КонецЕсли