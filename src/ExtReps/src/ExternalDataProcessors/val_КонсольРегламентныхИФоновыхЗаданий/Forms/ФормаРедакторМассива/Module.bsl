#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.ИсходныйМассив) = Тип("СписокЗначений") Тогда
		Массив.ЗагрузитьЗначения(Параметры.ИсходныйМассив.ВыгрузитьЗначения());
		Массив.ТипЗначения = Параметры.ИсходныйМассив.ТипЗначения;
	КонецЕсли;
	
	ТипЭлементовПредставление = ПредставлениеОписанияТипов(Массив.ТипЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипЭлементовПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьВыборТипаЭлементов(Ложь);
	
КонецПроцедуры

// Восстанавливает представление выбранного типа, если пользователь изменил его вручную.
//
// Параметры:
//   Элемент - ПолеФормы - поле ввода представления типа элементов.
//
&НаКлиенте
Процедура ТипЭлементовПредставлениеПриИзменении(Элемент)
	
	ТипЭлементовПредставление = ПредставлениеОписанияТипов(Массив.ТипЗначения);
	
КонецПроцедуры

// Очищает выбранный тип элементов массива.
//
// Параметры:
//   Элемент - ПолеФормы - поле ввода представления типа элементов.
//   СтандартнаяОбработка - Булево - Истина, если выполняется стандартная обработка события.
//
&НаКлиенте
Процедура ТипЭлементовПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Массив.ТипЗначения = Новый ОписаниеТипов;
	ТипЭлементовПредставление = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМассив

&НаКлиенте
Процедура МассивПередНачаломДобавления(Элемент, Отказ, Копирование)
	
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если Массив.ТипЗначения.Типы().Количество() > 0 Тогда
		// Тип уже выбран: строку добавляет платформа, она же делает её текущей.
		// При самостоятельном добавлении строки в этом обработчике платформа после
		// завершения команды сбрасывает активизацию таблицы на первую строку.
		Возврат;
	КонецЕсли;
	
	// Тип не выбран: сначала спрашиваем тип, строку добавим после выбора.
	Отказ = Истина;
	ОткрытьВыборТипаЭлементов(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Возвращает в вызывающую форму отредактированный список значений параметра регламентного задания.
//
// Параметры:
//   Команда - КомандаФормы - команда формы
//
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Закрыть(Массив);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открывает форму выбора типа значения для выбора типа элементов массива.
//
// Параметры:
//   ДобавитьЭлемент - Булево - Истина, если после выбора типа нужно добавить новый элемент массива.
//
&НаКлиенте
Процедура ОткрытьВыборТипаЭлементов(Знач ДобавитьЭлемент)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИсходноеОписаниеТипов", Массив.ТипЗначения);
	СтруктураПараметров.Вставить("ТолькоПростыеТипы", Истина);
	
	ДопПараметры = Новый Структура("ДобавитьЭлемент", ДобавитьЭлемент);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаЭлементов", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму(ПолноеИмяФормы("ФормаВыборТипаЗначения"), СтруктураПараметров, ЭтотОбъект, , , , 
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

// Обработчик завершения выбора типа значения.
//
// Параметры:
//   Результат - Структура, Неопределено - выбранные типы:
//     * ОписаниеТипов - ОписаниеТипов - описание выбранных типов.
//   ДополнительныеПараметры - Структура - дополнительные параметры:
//     * ДобавитьЭлемент - Булево - Истина, если нужно добавить новый элемент массива.
//
&НаКлиенте
Процедура ПослеВыбораТипаЭлементов(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Массив.ТипЗначения = Результат.ОписаниеТипов;
	ТипЭлементовПредставление = ПредставлениеОписанияТипов(Результат.ОписаниеТипов);
	
	ПривестиЗначенияКТипуЭлементов();
	
	Если ДополнительныеПараметры.ДобавитьЭлемент Тогда
		ДобавитьЭлементМассива();
	КонецЕсли;
	
КонецПроцедуры

// Добавляет в список новый элемент со значением по умолчанию для выбранного типа элементов.
//
&НаКлиенте
Процедура ДобавитьЭлементМассива()
	
	НовыйЭлемент = Массив.Добавить(Массив.ТипЗначения.ПривестиЗначение());
	Элементы.Массив.ТекущаяСтрока = НовыйЭлемент;
	
КонецПроцедуры

// Приводит значения всех элементов списка к выбранному типу элементов массива.
// Элементы, значение которых при приведении очистилось, удаляются из списка.
//
&НаКлиенте
Процедура ПривестиЗначенияКТипуЭлементов()
	
	УдаляемыеЭлементы = Новый Массив;
	
	Для Каждого ЭлементСписка Из Массив Цикл
		
		ПриведенноеЗначение = Массив.ТипЗначения.ПривестиЗначение(ЭлементСписка.Значение);
		
		Если ЗначениеЗаполнено(ПриведенноеЗначение) Тогда
			ЭлементСписка.Значение = ПриведенноеЗначение;
		Иначе
			УдаляемыеЭлементы.Добавить(ЭлементСписка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из УдаляемыеЭлементы Цикл
		Массив.Удалить(ЭлементСписка);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает полное имя формы этой же обработки.
//
// Параметры:
//   ИмяВызываемойФормы - Строка - имя формы обработки.
//
// Возвращаемое значение:
//   Строка - полное имя формы.
//
&НаКлиенте
Функция ПолноеИмяФормы(Знач ИмяВызываемойФормы)
	
	Возврат СтрЗаменить(ИмяФормы, "ФормаРедакторМассива", ИмяВызываемойФормы);
	
КонецФункции

// Возвращает представление описания типов с квалификаторами.
//
// Параметры:
//   ОписаниеТипов - ОписаниеТипов - описание типов.
//
// Возвращаемое значение:
//   Строка - представление, например "Число(10,2)" или "Строка(100), Число(15,2)".
//
&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеОписанияТипов(Знач ОписаниеТипов)
	
	Представления = Новый Массив;
	
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Представления.Добавить(ПредставлениеТипаСКвалификаторами(ТипЗначения, ОписаниеТипов));
	КонецЦикла;
	
	Возврат СтрСоединить(Представления, ", ");
	
КонецФункции

// Возвращает представление типа значения с учетом квалификаторов описания типов.
//
// Параметры:
//   ТипЗначения - Тип - тип значения.
//   ОписаниеТипов - ОписаниеТипов - описание типов, из которого взят тип значения.
//
// Возвращаемое значение:
//   Строка - представление типа значения.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеТипаСКвалификаторами(Знач ТипЗначения, Знач ОписаниеТипов)
	
	Если ТипЗначения = Тип("Число") Тогда
		
		Представление = СтрШаблон(НСтр("ru = 'Число(%1,%2)'; en = 'Number(%1,%2)'"),
			ОписаниеТипов.КвалификаторыЧисла.Разрядность,
			ОписаниеТипов.КвалификаторыЧисла.РазрядностьДробнойЧасти);
		
		Если ОписаниеТипов.КвалификаторыЧисла.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный Тогда
			Представление = Представление + " >= 0";
		КонецЕсли;
		
		Возврат Представление;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		
		Представление = СтрШаблон(НСтр("ru = 'Строка(%1)'; en = 'String(%1)'"), ОписаниеТипов.КвалификаторыСтроки.Длина);
		
		Если ОписаниеТипов.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная Тогда
			Представление = Представление + НСтр("ru = ', фиксированная'; en = ', fixed'");
		КонецЕсли;
		
		Возврат Представление;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Дата") Тогда
		
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат НСтр("ru = 'Дата'; en = 'Date'");
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат НСтр("ru = 'Время'; en = 'Time'");
		КонецЕсли;
		
		Возврат НСтр("ru = 'Дата и время'; en = 'Date and time'");
		
	КонецЕсли;
	
	Возврат Строка(ТипЗначения);
	
КонецФункции

#КонецОбласти
