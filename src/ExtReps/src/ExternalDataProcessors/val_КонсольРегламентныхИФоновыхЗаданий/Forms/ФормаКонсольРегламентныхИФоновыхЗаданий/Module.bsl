&НаСервереБезКонтекста
Функция ЕстьПодсистемаПользователи(Знач ИменаМетаданных)
	
	МетаданныеСтандартныеПодсистемы = Метаданные.Подсистемы.Найти(ИменаМетаданных.ПодсистемаСтандартныеПодсистемы);
	Если МетаданныеСтандартныеПодсистемы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьПодсистемаПользователи = НЕ (МетаданныеСтандартныеПодсистемы.Подсистемы.Найти(ИменаМетаданных.ПодсистемаПользователи) = Неопределено);
	Если НЕ ЕстьПодсистемаПользователи Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

// Возвращает свойства метаданных конфигурации: общие реквизиты, используемые как разделители
// данных, роли и языки.
//
// Возвращаемое значение:
//   Структура:
//     * DataSeparators - Структура - общие реквизиты, для которых установлено разделение данных:
//         ** Ключ - Строка - имя общего реквизита
//         ** Значение - Структура:
//             *** Presentation - Строка - представление общего реквизита
//             *** Type - Тип - тип общего реквизита
//     * Roles - СписокЗначений - роли конфигурации: значение - имя роли, представление - представление роли
//     * Languages - Структура - языки конфигурации: ключ - имя языка, значение - представление языка
&НаСервереБезКонтекста
Функция СвойстваМетаданныхКонфигурации()
	
	DataSeparators = New Structure;
	For Each CommonAttribute In Metadata.CommonAttributes Do
		If CommonAttribute.DataSeparation = Metadata.ObjectProperties.CommonAttributeDataSeparation.Separate Then
			CommonAttributeProperties = New Structure;
			CommonAttributeProperties.Insert("Presentation", CommonAttribute.Presentation());
			CommonAttributeProperties.Insert("Type", CommonAttribute.Type);
			DataSeparators.Insert(CommonAttribute.Name, CommonAttributeProperties);			
		EndIf;
	EndDo;
	
	Roles = New ValueList;
	For Each Role In Metadata.Roles Do
		Roles.Add(Role.Name, Role.Presentation());
	EndDo;
	
	Languages = New Structure;
	For Each Language In Metadata.Languages Do
		Languages.Insert(Language.Name, Language.Presentation());
	EndDo;
	
	Result = Новый Structure;
	Result.Insert("DataSeparators", DataSeparators);
	Result.Insert("Roles", Roles);
	Result.Insert("Languages", Languages);

	Возврат Result;
	
КонецФункции

&НаКлиенте
Процедура ПослеСозданияПользователя(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипРезультата = ТипЗнч(Результат);
	Если ТипРезультата = Тип("УникальныйИдентификатор") Тогда // Это добавление из стандартной формы
		РеквизитыПользователя = ИмяПользователяИнформационнойБазы(Результат);
	Иначе
		РеквизитыПользователя = РеквизитыПользователяПоСсылке(Результат);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(РеквизитыПользователя.Имя) Тогда
		
		Элементы.Задание_Пользователь.СписокВыбора.Добавить(РеквизитыПользователя.Имя, РеквизитыПользователя.ПолноеИмя);
		Задание_Пользователь = РеквизитыПользователя.Имя;
		
		УстановитьСвойствоРегламентногоЗадания("ИмяПользователя", Задание_Пользователь);
	
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру с пустыми именами пользователя для заполнения полей формы.
//
// Возвращаемое значение:
//   Структура:
//     * Имя - Строка - краткое имя пользователя
//     * ПолноеИмя - Строка - полное имя пользователя
&НаСервереБезКонтекста
Функция НовыеИменаПользователя()
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("ПолноеИмя", "");
	
	Возврат Результат;
КонецФункции

// Возвращает имя и полное имя пользователя информационной базы по его уникальному идентификатору.
// Если пользователь с указанным идентификатором не найден, возвращается незаполненная структура.
//
// Параметры:
//   ИДПользователя - УникальныйИдентификатор - идентификатор пользователя информационной базы
//
// Возвращаемое значение:
//   Структура - см. ФормаКонсольРегламентныхИФоновыхЗаданий.НовыеИменаПользователя
//
&НаСервереБезКонтекста
Функция ИмяПользователяИнформационнойБазы(Знач ИДПользоваетеля)
	
	Результат = НовыеИменаПользователя();
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИДПользоваетеля);
	Если НЕ ПользовательИБ = Неопределено Тогда
		Результат.Имя = ПользовательИБ.Имя;
		Результат.ПолноеИмя = ПользовательИБ.ПолноеИмя;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает реквизиты пользователя информационной базы по его ссылке.
//
// Параметры:
//   ПользовательИБ - СправочникСсылка.Пользователи - пользователь информационной базы
//
// Возвращаемое значение:
//   Структура - см. ФормаКонсольРегламентныхИФоновыхЗаданий.НовыеИменаПользователя
//
&НаСервереБезКонтекста
Функция РеквизитыПользователяПоСсылке(Знач ПользовательИБ)
	
	Результат = НовыеИменаПользователя();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ПользовательИБ);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.ИдентификаторПользователяИБ
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ	|	Пользователи.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = ИмяПользователяИнформационнойБазы(Выборка.ИдентификаторПользователяИБ);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	 

#КонецОбласти

#Область ВыполнениеРегламентныхЗаданий

&НаСервереБезКонтекста
// Запускает регламентное задание в текущем сеансе на сервере с указанными параметрами
//
// Параметры:
//   ИдентификаторЗадания - УникальныйИдентификатор - уникальный идентификатор регламентного задания
//   БезопасныйРежим - Булево - признак использования безопасного режима при выполнении
//
Процедура ЗапуститьЗаданиеВТекущемСеансеНаСервере(Знач ИдентификаторЗадания, Знач БезопасныйРежим = Истина)
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	ИмяМетода = РегламентноеЗадание.Метаданные.ИмяМетода;
	ПараметрыЗадания = РегламентноеЗадание.Параметры;
	
	МассивПараметров = Новый Массив; // Массив из Строка
	ШаблонПараметра = "ПараметрыЗадания[%1]";
	Для Индекс = 0 По ПараметрыЗадания.ВГраница() Цикл
		МассивПараметров.Добавить(СтрШаблон(ШаблонПараметра, Индекс));
	КонецЦикла;
	СтрокаПараметров = СтрСоединить(МассивПараметров, ", ");
	
	ВыполняемыйМетод = СтрШаблон("%1(%2);", ИмяМетода, СтрокаПараметров);
	
	Если БезопасныйРежим Тогда
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		//@skip-check server-execution-safe-mode
		Выполнить(ВыполняемыйМетод);
		
		ШаблонСообщения = НСтр("ru = 'Выполнено: %1'; en = 'Executed: %1'");
		СообщитьПользователю(СтрШаблон(ШаблонСообщения, ВыполняемыйМетод));
			
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
	Если БезопасныйРежим Тогда
		УстановитьБезопасныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Запускает регламентное задание вручную в виде фонового задания.
//
// Параметры:
//   ИдентификаторЗадания - УникальныйИдентификатор - идентификатор запускаемого регламентного задания
//
&НаСервереБезКонтекста
Процедура ЗапуститьЗаданиеВФоновомЗаданииНаСервере(Знач ИдентификаторЗадания)
	
	РегламентноеЗадание = ЗаданиеПоИдентификатору(ИдентификаторЗадания);
	Если РегламентноеЗадание = Неопределено Тогда
		ШаблонСообщения = НСтр("ru = 'Задание по идентификатору %1 не найдено. Обновите список и попробуйте ещё раз.';
							|en = 'The task by ID %1 not found. Refresh the list and try again'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ИдентификаторЗадания);
		СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	// проверка на выполнение в текущий момент
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", Строка(ИдентификаторЗадания));
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	Если МассивЗаданий.Количество() = 0 Тогда 
		
		ШаблонНаименования = НСтр("ru = 'Запуск вручную: %1'; en = 'Manual launch: %1'");
		НаименованиеФоновогоЗадания = СтрШаблон(ШаблонНаименования, РегламентноеЗадание.Метаданные.Синоним);
		
		ФоновоеЗадание = ФоновыеЗадания.Выполнить(РегламентноеЗадание.Метаданные.ИмяМетода, РегламентноеЗадание.Параметры, 
			Строка(ИдентификаторЗадания), НаименованиеФоновогоЗадания);
	Иначе
		ТекстСообщения = НСтр("ru = 'Задание уже выполняется'; en = 'The task has already started'");
		СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти