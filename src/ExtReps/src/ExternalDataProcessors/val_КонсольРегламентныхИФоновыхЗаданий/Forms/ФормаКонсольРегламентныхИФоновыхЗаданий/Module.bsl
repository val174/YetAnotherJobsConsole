// Возвращает соответствие имен объектов метаданных их локализованным (английским)
// представлениям для основного языка конфигурации.
//
// Возвращаемое значение:
//   Структура:
//     * ПодсистемаСтандартныеПодсистемы - Строка - имя подсистемы "СтандартныеПодсистемы"
//     * ПодсистемаПользователи - Строка - имя подсистемы "Пользователи"
//     * СправочникПользователи - Строка - имя справочника "Пользователи"
//
&НаСервереБезКонтекста
Функция ИменаЛокализованныхМетаданных()
	
	ИменаМетаданных = Новый Структура;
	ИменаМетаданных.Вставить("ПодсистемаСтандартныеПодсистемы", "СтандартныеПодсистемы");
	ИменаМетаданных.Вставить("ПодсистемаПользователи", "Пользователи");
	ИменаМетаданных.Вставить("СправочникПользователи", "Пользователи");
	
	Если Метаданные.ОсновнойЯзык.КодЯзыка = "en" Тогда
		
		ИменаМетаданных.ПодсистемаСтандартныеПодсистемы = "StandardSubsystems";
		ИменаМетаданных.ПодсистемаПользователи = "Users";
		ИменаМетаданных.СправочникПользователи = "Users";
			
	КонецЕсли;
	
	Возврат ИменаМетаданных;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТипаЗначения(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		СтрокаТаблицы = ПараметрыРегламентногоЗадания.НайтиПоИдентификатору(ДополнительныеПараметры.ИДСтроки);
		Если СтрокаТаблицы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаТаблицы.ТипПараметра = ВыбранноеЗначение.ОписаниеТипов;
		
		Если ВыбранноеЗначение.ОписаниеТипов.СодержитТип(Тип("Массив")) Тогда
			СтрокаТаблицы.Значение = Новый СписокЗначений;
		Иначе
			СтрокаТаблицы.Значение = ВыбранноеЗначение.ОписаниеТипов.ПривестиЗначение(СтрокаТаблицы.Значение);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

