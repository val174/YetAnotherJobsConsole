#КонецОбласти

#Область НастройкиКонсоли

// Загружает сохраненные настройки консоли из ХранилищаОбщихНастроек и применяет их к текущим настройкам объекта.
//
&НаСервере
Процедура ИнициализироватьНастройкиКонсоли()
	
	// инициализируем настройки консоли по умолчанию
	МодульОбъекта = РеквизитФормыВЗначение("Объект");
	НастройкиКонсоли = МодульОбъекта.НовыеНастройкиКонсоли(); // Структура
	
	СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить(МодульОбъекта.КлючОбъекта(), МодульОбъекта.КлючНастроек()); // Структура
	Если СохраненныеНастройки = Неопределено ИЛИ НЕ ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Настройка Из СохраненныеНастройки Цикл
		Если НастройкиКонсоли.Свойство(Настройка.Ключ) Тогда
			НастройкиКонсоли[Настройка.Ключ] = Настройка.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере(Знач НастройкиКонсоли)
	
	МодульОбъекта = РеквизитФормыВЗначение("Объект");
	
	ХранилищеОбщихНастроек.Сохранить(
		МодульОбъекта.КлючОбъекта(), МодульОбъекта.КлючНастроек(), НастройкиКонсоли
	);
	
КонецПроцедуры

#КонецОбласти

#Область РегламентныеЗадания

// Обновляет значение параметра регламентного задания после редактирования и сохраняет изменения параметров задания.
//
// Параметры:
//   Результат - Произвольный - новое значение параметра, установленное в диалоге редактирования
//   ДополнительныеПараметры - Структура - дополнительные параметры, содержащие идентификатор строки (свойство ИДСтроки)
//
&НаКлиенте
Процедура ПослеРедактированияСтруктуры(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		СтрокаТаблицы = ПараметрыРегламентногоЗадания.НайтиПоИдентификатору(ДополнительныеПараметры.ИДСтроки);
		Если СтрокаТаблицы <> Неопределено Тогда
			СтрокаТаблицы.Значение = Результат;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьСвойствоРегламентногоЗадания("Параметры", ПараметрыЗаданияВВМассив());
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗаданияВВМассив()
	
	Возврат ПараметрыРегламентногоЗадания.Выгрузить().ВыгрузитьКолонку("Значение");
	
КонецФункции

&НаКлиенте
Процедура УстановитьБыстрыеФильтры()
	
	ОтборСтрок = Неопределено;
	
	Отбор = Новый Структура;
	
	Если Элементы.БыстрыйФильтр_Включенные.Пометка Тогда
		Отбор.Вставить("Использование", Истина);
	КонецЕсли;
	
	Если Элементы.БыстрыйФильтр_Активные.Пометка Тогда
		Отбор.Вставить("Состояние", ТекстСостояниеВыполняется());
	КонецЕсли;
	
	Если Элементы.БыстрыйФильтр_СОшибками.Пометка Тогда
		Отбор.Вставить("ЗавершеноСОшибками", Истина);		
	КонецЕсли;
	
	Если Элементы.БыстрыйФильтр_Избранное.Пометка Тогда
		Отбор.Вставить("Избранное", Истина);
	КонецЕсли;
	
	Если Отбор.Количество() Тогда
		ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	КонецЕсли;
	
	Элементы.СписокРегламентныеЗадания.ОтборСтрок = ОтборСтрок;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборРегламентныхЗаданийПоМетаданным()
	
	СтрокаТаблицы = Элементы.СписокМетаданныеРегламентныхЗаданий.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Элементы.СписокРегламентныеЗадания.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ПоказыватьМетаданные Тогда
		ОтборСтрок = Новый Структура("Метаданные", СтрокаТаблицы.Имя);
		Элементы.СписокРегламентныеЗадания.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	Иначе
		Элементы.СписокРегламентныеЗадания.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИзменитьРасписаниеЗадания(Знач ЗаписатьЗаданиеПослеИзменения = Ложь, Знач МассивЗаданий = Неопределено)
	
	Если Расписание = Неопределено Тогда
		Расписание = РасписаниеПоУмолчанию(Задание_Идентификатор);
	КонецЕсли;
	
	Если МассивЗаданий = Неопределено Тогда
		МассивЗаданий = Новый Массив;
		МассивЗаданий.Добавить(Задание_Идентификатор);
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Результат = Ждать Диалог.ОткрытьАсинх();
	Если Результат <> Неопределено Тогда
		Расписание = Результат;
				
		Модифицированность = Истина;
		
		Для Каждого ИдЗадания Из МассивЗаданий Цикл
			УстановитьСвойствоРегламентногоЗадания("УникальныйИдентификатор", ИдЗадания);
			УстановитьСвойствоРегламентногоЗадания("Расписание", Расписание);
			
			Если ЗаписатьЗаданиеПослеИзменения Тогда
				ОбновитьРасписаниеЗадания(ИдЗадания);
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы.НадписьРасписание.Заголовок = Строка(Расписание);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура УдалитьТекущееЗадание()
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТаблицы.Предопределенное Тогда
		Ждать ПредупреждениеАсинх(НСтр("ru = 'Удаление предопределенных заданий невозможно!'"), 30, НСтр("ru = 'Ошибка удаления'"));
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Вы действительно хотите удалить регламентное задание
	| ""%1""?'");
	ТекстВопроса = СтрЗаменить(ТекстВопроса, "%1", СтрокаТаблицы.Наименование);
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, 
		РежимДиалогаВопрос.ДаНет,
		30,
		КодВозвратаДиалога.Нет,
		НСтр("ru = 'Удаление регламентного задания'"),
		КодВозвратаДиалога.Нет
	); // КодВозвратаДиалога
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗадания = СтрокаТаблицы.Идентификатор;
	УдалитьРегламентноеЗаданиеНаСервере(ИдентификаторЗадания);
	
	ОбновитьСпискиФормы();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВключитьВыключитьРегламентныеЗадания(Знач Использование)
	
	ВыбранныеЗадания = Элементы.СписокРегламентныеЗадания.ВыделенныеСтроки;
	Если ВыбранныеЗадания.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'Не выбрано ни одного задания';en = 'No task is selected'"));
		Возврат;
	КонецЕсли;
	
	ШаблонВопроса = НСтр("ru = '%1 выбранные задания?'; en = '%1 selected tasks?'");
	ФорматнаяСтрока = НСтр("ru = 'БЛ=Выключить; БИ=Включить'; en = 'БЛ=Disable; БИ=Enable'");
	ТекстВопроса = СтрШаблон(ШаблонВопроса, Формат(Использование, ФорматнаяСтрока));
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет); // КодВозвратаДиалога
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьИспользованиеРегламентныхЗаданий(ВыбранныеЗадания, Использование);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИспользованиеРегламентныхЗаданий(Знач ВыбранныеЗадания, Знач Использование)
	
	Для каждого ИДСтроки Из ВыбранныеЗадания Цикл
		
		//@skip-check invocation-parameter-type-intersect
		СтрокаТЗ = СписокРегламентныеЗадания.НайтиПоИдентификатору(ИДСтроки);
		
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(СтрокаТЗ.Идентификатор);
		
		Если Задание <> Неопределено Тогда
			
			Задание.Использование = Использование;
			Задание.Записать();
			
			СтрокаТЗ.Использование = Использование;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСписокИзбранного(Знач МетаданныеЗадания, Знач Избранное)
	
	СтрокиЗаданий = СписокРегламентныеЗадания.НайтиСтроки(Новый Структура("Метаданные", МетаданныеЗадания));
	Для каждого СтрокаТаблицы Из СтрокиЗаданий Цикл
		СтрокаТаблицы.Избранное = Избранное;
	КонецЦикла;
	
	Если Избранное Тогда
		НастройкиКонсоли.Избранное.Добавить(МетаданныеЗадания);
	Иначе
		Индекс = НастройкиКонсоли.Избранное.Найти(МетаданныеЗадания);
		Если Индекс <> Неопределено Тогда
			НастройкиКонсоли.Избранное.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьКартинкуИзбранного();
	СохранитьНастройкиНаСервере(НастройкиКонсоли);	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвойствоРегламентногоЗадания(Знач Свойство, Знач ЗначениеСвойства)
	
	Если СвойстваРегламентногоЗадания = Неопределено Тогда
		СвойстваРегламентногоЗадания = Новый Структура;
	КонецЕсли;
	
	СвойстваРегламентногоЗадания.Вставить(Свойство, ЗначениеСвойства);
	
	Если Свойство <> "УникальныйИдентификатор" Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРасписаниеЗадания(Знач Задание_Идентификатор)
	
	РасписаниеОбновлено = ЗаписатьРегламентноеЗаданиеНаСервере(СвойстваРегламентногоЗадания);
	Если НЕ РасписаниеОбновлено Тогда
		Возврат;
	КонецЕсли;
	
	//@skip-check property-return-type
	ПредставлениеРаcписания = Строка(СвойстваРегламентногоЗадания.Расписание);
	СвойстваРегламентногоЗадания.Очистить();
	
	Модифицированность = Ложь;
	
	СтрокаТаблицы = СтрокаРегламентногоЗаданияПоИдентификатору(Задание_Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы.Расписание = ПредставлениеРаcписания;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаРегламентногоЗаданияПоИдентификатору(Знач Идентификатор)
	
	НайденнаяСтрока = Неопределено;
	
	Отбор = Новый Структура("Идентификатор", Идентификатор);
	
	СтрокиСписка = СписокРегламентныеЗадания.НайтиСтроки(Отбор);
	Если СтрокиСписка.Количество() Тогда
		НайденнаяСтрока = СтрокиСписка[0];
	КонецЕсли;
	
	Возврат НайденнаяСтрока;
	
КонецФункции

&НаСервере
Процедура ОбновитьМетаданныеКонфигурации(Знач ОбновитьПринудительно = Ложь)
	
	Если НЕ ПоказыватьМетаданные И НЕ ОбновитьПринудительно Тогда
		Возврат;
	КонецЕсли;
	
	СписокМетаданныеРегламентныхЗаданий.Очистить();
	
	СписокВыбора = Элементы.Задание_Метаданные.СписокВыбора;
	СписокВыбора.Очистить();
		
	Для каждого МетаданныеРЗ Из Метаданные.РегламентныеЗадания Цикл
		
		НоваяСтрока = СписокМетаданныеРегламентныхЗаданий.Добавить();
		НоваяСтрока.Метаданные = МетаданныеРЗ.ПолноеИмя();
		НоваяСтрока.Синоним = СтрШаблон("%1 (%2)", МетаданныеРЗ.Синоним, МетаданныеРЗ.Имя);
		НоваяСтрока.Имя = МетаданныеРЗ.Имя;
		НоваяСтрока.Избранное = (НастройкиКонсоли.Избранное.Найти(НоваяСтрока.Имя) <> Неопределено);
		
		//@skip-check typed-value-adding-to-untyped-collection
		СписокВыбора.Добавить(МетаданныеРЗ.Имя, МетаданныеРЗ.Синоним);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокРегламентныхЗаданий(Знач ВывестиРезультатПоследнегоЗапуска = Ложь)
	
	Попытка
		МассивРегламентных = РегламентныеЗадания.ПолучитьРегламентныеЗадания(); // Массив из РегламентноеЗадание
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	СписокРегламентныеЗадания.Очистить();
	СписокВыбораРЗ = Элементы.ОтборФоновыхПоРегламентномуЗаданию.СписокВыбора;
	СписокВыбораРЗ.Очистить();
	
	Для каждого Регламентное Из МассивРегламентных Цикл
		
		НоваяСтрока = СписокРегламентныеЗадания.Добавить();
		НоваяСтрока.Использование = Регламентное.Использование;
		НоваяСтрока.Идентификатор = Регламентное.УникальныйИдентификатор;
		НоваяСтрока.Метаданные = Регламентное.Метаданные.Имя;
		НоваяСтрока.Наименование = Регламентное.Наименование;
		
		Если ПустаяСтрока(НоваяСтрока.Наименование) Тогда
			НоваяСтрока.Наименование = Регламентное.Метаданные.Представление();
		КонецЕсли;
		
		НоваяСтрока.Ключ = Регламентное.Ключ;
		НоваяСтрока.Предопределенное = Регламентное.Предопределенное;
		НоваяСтрока.Расписание = Строка(Регламентное.Расписание);
		НоваяСтрока.КоличествоПовторовПриАварийномЗавершении = Регламентное.КоличествоПовторовПриАварийномЗавершении;
		НоваяСтрока.ИнтервалПовтораПриАварийномЗавершении = Регламентное.ИнтервалПовтораПриАварийномЗавершении;
		НоваяСтрока.Метод = Регламентное.Метаданные.ИмяМетода;
		НоваяСтрока.Пользователь = Регламентное.ИмяПользователя;
		НоваяСтрока.Избранное = (НастройкиКонсоли.Избранное.Найти(НоваяСтрока.Метаданные) <> Неопределено);
		
		Если ВывестиРезультатПоследнегоЗапуска Тогда
			РезультатПоследнегоЗапуска = РезультатПоследнегоЗапуска(Регламентное.УникальныйИдентификатор, Регламентное);
		
			НоваяСтрока.ДатаЗапуска = РезультатПоследнегоЗапуска.ДатаЗапуска;
			НоваяСтрока.Состояние = РезультатПоследнегоЗапуска.Состояние;
			НоваяСтрока.ТекстОшибки = РезультатПоследнегоЗапуска.ТекстОшибки;
			НоваяСтрока.ЗавершеноСОшибками = НЕ ПустаяСтрока(НоваяСтрока.ТекстОшибки);
			
			//@skip-check property-return-type
			Если НастройкиКонсоли.РассчитыватьДатуСледующегоЗапускаРегламентногоЗадания Тогда
				НоваяСтрока.СледующийЗапуск = ДатаСледующегоЗапускаРегламентногоЗадания(
					Регламентное.Расписание, Регламентное.Использование, РезультатПоследнегоЗапуска);
			КонецЕсли;
			
		КонецЕсли;
		
		//@skip-check typed-value-adding-to-untyped-collection
		СписокВыбораРЗ.Добавить(Строка(Регламентное.УникальныйИдентификатор), НоваяСтрока.Наименование);
		
	КонецЦикла;
	
	СписокВыбораРЗ.СортироватьПоПредставлению();
	
	КоличествоРегламентныхЗаданий = СписокРегламентныеЗадания.Количество();
	
КонецПроцедуры

// Вычисляет дату следующего запуска регламентного задания
//
// Параметры:
//  Расписание - РасписаниеРегламентногоЗадания - расписание для анализа
//  Использование - Булево - значение одноименного свойства рег. задания
//  РезультатПоследнегоЗапуска - Структура - см. НовыйРезультатПоследнегоЗапуска()
//
// Возвращаемое значение:
//  Дата - дата следующего запуска или ПустаяДата, если запуск не найден
//
&НаКлиентеНаСервереБезКонтекста
Функция ДатаСледующегоЗапускаРегламентногоЗадания(Знач Расписание, Знач Использование, Знач РезультатПоследнегоЗапуска)
	
	Если Расписание = Неопределено ИЛИ НЕ Использование Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	#Если Сервер Тогда
		ДатаДляПроверки = ТекущаяДатаСеанса();
	#Иначе
		ДатаДляПроверки = ТекущаяДата();
	#КонецЕсли
	
	ДатаСледующегоЗапуска = Дата(1, 1, 1);
	
	МаксимальныйИнтервалПоиска = 2592000; // (30 дней в секундах)
	ИнтервалПроверки = 60; // секунд
	
	ДатаКонцаПоиска = ДатаДляПроверки + МаксимальныйИнтервалПоиска;
	
	Пока ДатаДляПроверки <= ДатаКонцаПоиска Цикл
		
		ТребуетсяВыполнение = Расписание.ТребуетсяВыполнение(ДатаДляПроверки, РезультатПоследнегоЗапуска.ДатаЗапуска, РезультатПоследнегоЗапуска.ДатаЗавершения);
		Если ТребуетсяВыполнение Тогда
			ДатаСледующегоЗапуска = ДатаДляПроверки;
			Прервать;
		КонецЕсли;
		
		ДатаДляПроверки = ДатаДляПроверки + ИнтервалПроверки;
		
	КонецЦикла;
	
	Возврат ДатаСледующегоЗапуска;
	
КонецФункции

// Заполняет свойства реквизитов формы регламентного задания
// 
// Параметры:
//  ИДСтроки - Число - идентификатор строки таблицы формы
//
&НаКлиенте
Процедура ЗаполнитьСвойстваРегламентногоЗадания(Знач ИДСтроки)
	
	СтрокаТаблицы = СписокРегламентныеЗадания.НайтиПоИдентификатору(ИДСтроки);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Задание_Ключ = СтрокаТаблицы.Ключ;
	Задание_Наименование = СтрокаТаблицы.Наименование;
	Задание_Использование = СтрокаТаблицы.Использование;
	Задание_Метаданные = СтрокаТаблицы.Метаданные;
	Задание_Предопределенное = СтрокаТаблицы.Предопределенное;
	Задание_Метод = СтрокаТаблицы.Метод;
	Задание_Пользователь = СтрокаТаблицы.Пользователь;
	Задание_Идентификатор = СтрокаТаблицы.Идентификатор;
	Задание_ИнтервалПовтораПриАварийномЗавершении = СтрокаТаблицы.ИнтервалПовтораПриАварийномЗавершении;
	Задание_КоличествоПовторовПриАварийномЗавершении = СтрокаТаблицы.КоличествоПовторовПриАварийномЗавершении;
	Задание_Избранное = СтрокаТаблицы.Избранное;

	УстановитьКартинкуИзбранного();
		
	УстановитьСвойствоРегламентногоЗадания("УникальныйИдентификатор", Задание_Идентификатор);
	
	ЗаполнитьСвойстваРегламентногоЗаданияНаСервере(Задание_Идентификатор);
	
	Расписание = РасписаниеПоУмолчанию(Задание_Идентификатор);
	Элементы.НадписьРасписание.Заголовок = Строка(Расписание);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКартинкуИзбранного()
	
	Если Задание_Избранное Тогда
		Элементы.КартинкаИзбранное.Картинка = БиблиотекаКартинок.ДобавитьВИзбранное;
	Иначе
		Элементы.КартинкаИзбранное.Картинка = БиблиотекаКартинок.Избранное;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьСвойстваРегламентногоЗадания()
	
	СвойстваРегламентногоЗадания.Очистить();
	
	Задание_Ключ = "";
	Задание_Наименование = "";
	Задание_Использование = Ложь;
	Задание_Метаданные = "";
	Задание_Идентификатор = Новый УникальныйИдентификатор();
	Задание_ИнтервалПовтораПриАварийномЗавершении = 0;
	Задание_КоличествоПовторовПриАварийномЗавершении = 0;
	Задание_Пользователь = "";
	Задание_Метод = "";
	ПараметрыРегламентногоЗадания.Очистить();
	Задание_Ошибка = "";
	Задание_Состояние = "";
	Задание_КоличествоПараметров = 0;
	
	Элементы.НадписьРасписание.Заголовок = НадписьРасписаниеПоУмолчанию();
	
	Модифицированность = Ложь;
	ЭтоДобавлениеЗадания = Ложь;
	ЭтоРегламентноеЗадание = Ложь;
	
	Расписание = Новый РасписаниеРегламентногоЗадания();
	
КонецПроцедуры

// Заполнить свойства регламентного задания на сервере.
// 
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор - уникальный идентификатор регламентного задания.
//
&НаСервере
Процедура ЗаполнитьСвойстваРегламентногоЗаданияНаСервере(Знач ИдентификаторЗадания)
	
	РегламентноеЗадание = ЗаданиеПоИдентификатору(ИдентификаторЗадания);
	
	ЗаполнитьПараметрыРегламентногоЗадания(РегламентноеЗадание);
	
	РезультатПоследнегоЗапуска = РезультатПоследнегоЗапуска(ИдентификаторЗадания, РегламентноеЗадание);
	Задание_Состояние = РезультатПоследнегоЗапуска.Состояние;
	Задание_Ошибка = РезультатПоследнегоЗапуска.ТекстОшибки;
	Задание_Сообщения = СтрСоединить(РезультатПоследнегоЗапуска.Сообщения, Символы.ПС);
	
КонецПроцедуры

// Заполняет таблицу параметров регламентного задания значениями из переданного задания,
// дополняя её параметрами по умолчанию, отсутствующими в задании.
//
// Параметры:
//   РегламентноеЗадание - РегламентноеЗадание, Неопределено - задание, параметры которого переносятся
//                       в таблицу; если Неопределено, таблица заполняется только параметрами по умолчанию
//
&НаСервере
Процедура ЗаполнитьПараметрыРегламентногоЗадания(Знач РегламентноеЗадание = Неопределено)
	
	ПараметрыЗаданияПоУмолчанию = ПараметрыРегламентногоЗаданияПоУмолчанию(Задание_Метаданные);
	
	ПараметрыРегламентногоЗадания.Очистить();
	
	ТаблицаПараметров = ПараметрыРегламентногоЗадания.Выгрузить().СкопироватьКолонки();
	
	Если РегламентноеЗадание <> Неопределено Тогда
		
		ИндексПараметра = 0;
	
		// Добавлены параметры
		Для Каждого Параметр Из РегламентноеЗадание.Параметры Цикл
			НоваяСтрока = ТаблицаПараметров.Добавить();
			НоваяСтрока.Значение = Параметр; //@skip-check property-return-type
			
			НоваяСтрока.ТипПараметра = ОписаниеТиповПараметраЗадания(ТипЗнч(Параметр));
			
			Если ИндексПараметра <= ПараметрыЗаданияПоУмолчанию.ВГраница() Тогда
				ПараметрПоУмолчанию = ПараметрыЗаданияПоУмолчанию[ИндексПараметра];
				НоваяСтрока.ИмяПараметра = ПараметрПоУмолчанию.Имя;
				
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.Значение) Тогда
					НоваяСтрока.Значение = ПараметрПоУмолчанию.ЗначениеПоУмолчанию; 
					НоваяСтрока.ТипПараметра = ОписаниеТиповПараметраЗадания(Тип(ПараметрПоУмолчанию.Тип));					
				КонецЕсли;
				
			КонецЕсли;
			
			ИндексПараметра = ИндексПараметра + 1;
			
		КонецЦикла;
			
	КонецЕсли;
	 
	Если ПараметрыЗаданияПоУмолчанию.Количество() Тогда
		
		Для Каждого Параметр Из ПараметрыЗаданияПоУмолчанию Цикл
			
			Если ТаблицаПараметров.Найти(Параметр.Имя, "ИмяПараметра") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаПараметров.Добавить();
			НоваяСтрока.ИмяПараметра = Параметр.Имя;
			НоваяСтрока.Значение = Параметр.ЗначениеПоУмолчанию; //@skip-check property-return-type
					
			НоваяСтрока.ТипПараметра = ОписаниеТиповПараметраЗадания(Тип(Параметр.Тип));
		КонецЦикла;
		
	КонецЕсли;
	
	ПараметрыРегламентногоЗадания.Загрузить(ТаблицаПараметров);
	
	Задание_КоличествоПараметров = ПараметрыРегламентногоЗадания.Количество();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеТиповПараметраЗадания(Знач ТипПараметра)
	
	Если НЕ ЗначениеЗаполнено(ТипПараметра) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипПараметра); //@skip-check typed-value-adding-to-untyped-collection
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

&НаСервере
Функция ПараметрыРегламентногоЗаданияПоУмолчанию(Знач ИмяЗадания)
	
	МодульПараметрыРегламентныхЗаданий = ОбщийМодуль_ПараметрыРегламентныхЗаданий(НастройкиКонсоли.ИмяМодуляРегламентныхЗаданий);
	Если МодульПараметрыРегламентныхЗаданий = Неопределено Тогда
		
		МодульПараметрыРегламентныхЗаданий = РеквизитФормыВЗначение("Объект");
		
	КонецЕсли;
	
	Возврат МодульПараметрыРегламентныхЗаданий.ПараметрыРегламентногоЗадания(ИмяЗадания);
	
КонецФункции

// Возвращает объект общего модуля по имени после проверки существования в метаданных.
//
// Параметры:
//   ИмяМодуля - Строка - имя общего модуля
//
// Возвращаемое значение:
//   ОбщийМодуль - объект общего модуля
//   Неопределено - если модуль не найден или имя пустое
//
&НаСервереБезКонтекста
Функция ОбщийМодуль_ПараметрыРегламентныхЗаданий(Знач ИмяМодуля)
	
	Модуль = Неопределено;
	
	Если НЕ ПустаяСтрока(ИмяМодуля) И Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено Тогда
		//@skip-check server-execution-safe-mode
		Модуль = Вычислить(ИмяМодуля); // ВычислитьВБезопасномРежиме не требуется, т.к. проверка надежная.
	КонецЕсли;
	
	Возврат Модуль;
	
КонецФункции

// Возвращает расписание регламентного задания
// 
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор - уникальный идентификатор регламентного задания
// 
// Возвращаемое значение:
//  РасписаниеРегламентногоЗадания - расписание по умолчанию
//
&НаСервереБезКонтекста
Функция РасписаниеПоУмолчанию(Знач ИдентификаторЗадания)

	РегламентноеЗадание = ЗаданиеПоИдентификатору(ИдентификаторЗадания);
	
	Если РегламентноеЗадание = Неопределено Тогда
		Возврат Новый РасписаниеРегламентногоЗадания();
	КонецЕсли;
	
	Возврат РегламентноеЗадание.Расписание;

КонецФункции

// Записать регламентное задание на сервере.
// 
// Параметры:
//  СвойстваЗадания - Структура - структура свойств регламентного задания. Ключи структуры:
//   * УникальныйИдентификатор - УникальныйИдентификатор - Обязателен, если изменяются свойства существующего задания
//   * Метаданные - Строка - имя метаданных регламентного задания, обязательно для нового задания
//   * ИмяПользователя - Строка - имя пользователя, под которым будет выполняться данное регламентное задание
//   * ИнтервалПовтораПриАварийномЗавершении - Число - интервал в секундах, через который нужно перезапускать задание в случае его аварийного завершения
//   * Использование - Булево - признак использования регламентного задания
//   * Ключ - Строка - прикладной идентификатор
//   * КоличествоПовторовПриАварийномЗавершении - Число - количество повторов при аварийном завершении задания
//   * Наименование - Строка - наименование регламентного задания
//   * Параметры - Массив - массив параметров регламентного задания
//   * Расписание - РасписаниеРегламентногоЗадания - расписание задания
// 
// Возвращаемое значение:
//  Булево - Истина - если задание записано, Ложь - если возникла ошибка.
&НаСервереБезКонтекста
Функция ЗаписатьРегламентноеЗаданиеНаСервере(Знач СвойстваЗадания)
	
	Если СвойстваЗадания = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Запись задания не возможна: не заданы свойства задания';
						|en = 'Task recording is not possible: the task properties are not set.'"); // Строка
		СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Истина;
	
	Попытка
		
		РегламентноеЗадание = ЗаданиеПоИдентификатору(СвойстваЗадания.УникальныйИдентификатор);
		
		Если РегламентноеЗадание = Неопределено Тогда
			
			Если НЕ СвойстваЗадания.Свойство("Метаданные") ИЛИ НЕ ЗначениеЗаполнено(СвойстваЗадания.Метаданные) Тогда
				ВызватьИсключение("Не выбраны метаданные регламентного задания.");
			КонецЕсли;
			
			РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(СвойстваЗадания.Метаданные);
			Задание_Идентификатор = РегламентноеЗадание.УникальныйИдентификатор;
			СвойстваЗадания.УникальныйИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
		КонецЕсли;
		
		Для Каждого КлючЗначение Из СвойстваЗадания Цикл
			
			Если КлючЗначение.Ключ = "УникальныйИдентификатор" ИЛИ КлючЗначение.Ключ = "Метаданные" Тогда
				Продолжить;
			КонецЕсли;
			
			РегламентноеЗадание[КлючЗначение.Ключ] = КлючЗначение.Значение;
			
		КонецЦикла;
		
		РегламентноеЗадание.Записать();
	Исключение
		Результат = Ложь;
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка: %1'"), 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
			
		СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Удаляет регламентное задание по его идентификатору.
//
// Параметры:
//   ИдентификаторЗадания - Строка, УникальныйИдентификатор - идентификатор удаляемого регламентного задания.
//
// Возвращаемое значение:
//   Булево - Истина, если задание удалено или не найдено, Ложь, если при удалении произошла ошибка.
//
&НаСервереБезКонтекста
Функция УдалитьРегламентноеЗаданиеНаСервере(Знач ИдентификаторЗадания)
	
	Результат = Истина;
	
	Задание = ЗаданиеПоИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		СообщитьПользователю(НСтр("ru = 'Регламентное задание не найдено.'; en = 'The scheduled task was not found.'"));
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		Задание.Удалить();
		
	Исключение
		
		Результат = Ложь;
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СообщитьПользователю(ТекстОшибки);

	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя метода регламентного задания по имени задания.
//
// Параметры:
//   ИмяЗадания - Строка - имя регламентного задания в метаданных.
//
// Возвращаемое значение:
//   Строка - имя метода регламентного задания; пустая строка, если задание не найдено.
//
&НаСервереБезКонтекста
Функция МетодРегламентногоЗадания(Знач ИмяЗадания)

	ИмяМетодаЗадания = "";

	МетаданныЗадания = Метаданные.РегламентныеЗадания.Найти(ИмяЗадания);
	Если МетаданныЗадания <> Неопределено Тогда
		ИмяМетодаЗадания = МетаданныЗадания.ИмяМетода;	
	КонецЕсли;
	
	Возврат ИмяМетодаЗадания;

КонецФункции

#КонецОбласти

#Область ФоновыеЗадания

&НаСервере
Процедура ОбновитьСписокФоновыхЗаданийНаСервере()
	
	ОтборФоновых = НовыйОтборФоновыхЗаданий();
	МассивФоновых = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФоновых);
	
	ВыведеноФоновых = 0;
	
	СписокФоновыеЗадания.Очистить();
	Для Каждого Фоновое Из МассивФоновых Цикл
		НоваяСтрока = СписокФоновыеЗадания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Фоновое);
		
		НоваяСтрока.КоличествоСообщений = Фоновое.ПолучитьСообщенияПользователю().Количество();
		НоваяСтрока.Идентификатор = Фоновое.УникальныйИдентификатор;
			
		СообщенияИОшибки = СообщенияОшибкаФоновогоЗадания(Фоновое);
		
		НоваяСтрока.Сообщения = СтрСоединить(СообщенияИОшибки.Сообщения, Символы.ПС);
		НоваяСтрока.ТекстОшибки = СообщенияИОшибки.ТекстОшибки;
		НоваяСтрока.ЗавершеноСОшибками = НЕ ПустаяСтрока(НоваяСтрока.ТекстОшибки);
		
		Если Фоновое.РегламентноеЗадание <> Неопределено Тогда
			НоваяСтрока.РегламентноеЗадание = Фоновое.РегламентноеЗадание.УникальныйИдентификатор;
			НоваяСтрока.РегламентноеЗадание_Наименование = Фоновое.РегламентноеЗадание.Наименование;
		КонецЕсли;
		
		ВыведеноФоновых = ВыведеноФоновых + 1;
		Если ПоказыватьФоновыхЗаданий > 0 И ВыведеноФоновых >= ПоказыватьФоновыхЗаданий Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	СписокФоновыеЗадания.Сортировать("Начало Убыв");
	КоличествоФоновыхЗаданий = СписокФоновыеЗадания.Количество();
	
КонецПроцедуры

&НаСервере
Функция НовыйОтборФоновыхЗаданий()
	
	ОтборФоновых = Новый Структура;
	
	ОтборФоновых.Вставить("Начало", ДатаНачала);
	ОтборФоновых.Вставить("Конец", ДатаОкончания);
	
	Если ЗначениеЗаполнено(ОтборФоновых_РегламентноеЗадание) Тогда
		РегламентноеЗадание = ЗаданиеПоИдентификатору(Новый УникальныйИдентификатор(ОтборФоновых_РегламентноеЗадание));
		Если РегламентноеЗадание <> Неопределено Тогда
			ОтборФоновых.Вставить("РегламентноеЗадание", РегламентноеЗадание);
		КонецЕсли;
	КонецЕсли;
	
	ОтборФоновых.Вставить("Состояние", СостоянияФоновыхЗаданий());
	
	Возврат ОтборФоновых;
	
КонецФункции

// Состояния фоновых заданий.
// 
// Возвращаемое значение:
//  СостояниеФоновогоЗадания, Массив из СостояниеФоновогоЗадания - Состояния фоновых заданий
&НаСервере
Функция СостоянияФоновыхЗаданий()
	
	МассивСостояний = Новый Массив(); // Массив из СостояниеФоновогоЗадания
	Если ФоновоеЗадание_Активно Тогда
		МассивСостояний.Добавить(СостояниеФоновогоЗадания.Активно);
	КонецЕсли;
	
	Если ФоновоеЗадание_Завершено Тогда
		МассивСостояний.Добавить(СостояниеФоновогоЗадания.Завершено);
	КонецЕсли;
	
	Если ФоновоеЗадание_ЗавершеноАварийно Тогда
		МассивСостояний.Добавить(СостояниеФоновогоЗадания.ЗавершеноАварийно);
	КонецЕсли;
	
	Если ФоновоеЗадание_Отменено Тогда
		МассивСостояний.Добавить(СостояниеФоновогоЗадания.Отменено);
	КонецЕсли;
	
	Если МассивСостояний.Количество() = 1 Тогда
		Возврат МассивСостояний[0];
	КонецЕсли;
	
	Возврат МассивСостояний;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИнтервалФоновыхЗаданий()
	
	ЭлементИнтервал = Элементы.ИнтервалФоновыхЗаданий;
		
	Если (ИнтервалФоновыхЗаданий = 0) Тогда
		
		// произвольный интервал
		
		Если (НЕ ЗначениеЗаполнено(ДатаОкончания)) Тогда
			ДатаОкончания = ТекущаяДата();
		КонецЕсли;
		
		Если (НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ДатаНачала > ДатаОкончания) Тогда
			ДатаНачала = ДатаОкончания - 60 * 60; // по умолчанию сделаем "последний час"
		КонецЕсли;
		
	Иначе
		
		// интервал равен значению интервала в минутах
		
		ДатаОкончания = ТекущаяДата();
		ДатаНачала  = ДатаОкончания - ИнтервалФоновыхЗаданий * 60;
		
		ЭлементИнтервал.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
		
	КонецЕсли;
	
	ЭлементИнтервал.Подсказка = Строка(ДатаНачала) + " - " + Строка(ДатаОкончания);
	
	Элементы.ГруппаПроизвольныйИнтервал.Видимость = (ИнтервалФоновыхЗаданий = 0);
	
КонецПроцедуры

// Результат последнего запуска фонового задания
// 
// Параметры:
//  ИдентификаторЗадания  - УникальныйИдентификатор - уникальный идентификатор регламентного задания
//  РегламентноеЗадание - Неопределено - Регламентное задание
// 
// Возвращаемое значение:
//  Структура - см. НовыйРезультатПоследнегоЗапуска() 
//
&НаСервереБезКонтекста
Функция РезультатПоследнегоЗапуска(Знач ИдентификаторЗадания, Знач РегламентноеЗадание = Неопределено)
	
	Результат = НовыйРезультатПоследнегоЗапуска();
	
	Если РегламентноеЗадание = Неопределено Тогда
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	КонецЕсли;
	
	Если РегламентноеЗадание <> Неопределено Тогда
		
		Попытка
			
			ПоследнееЗадание = РегламентноеЗадание.ПоследнееЗадание;
			
		Исключение
			
			ПоследнееЗадание = Неопределено;
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СообщитьПользователю(ТекстОшибки);
			
			Возврат Результат;
			
		КонецПопытки;
		
		Если ПоследнееЗадание <> Неопределено Тогда
			Результат.ДатаЗапуска = ПоследнееЗадание.Начало;
			Если ПоследнееЗадание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				Результат.Длительность = ПоследнееЗадание.Конец - ПоследнееЗадание.Начало; //@skip-check statement-type-change
			КонецЕсли;
			
			Результат.ДатаЗавершения = ПоследнееЗадание.Конец;
			
			Результат.Состояние = Строка(ПоследнееЗадание.Состояние);
			
			СообщенияИОшибки = СообщенияОшибкаФоновогоЗадания(ПоследнееЗадание);
			
			Результат.Сообщения = СообщенияИОшибки.Сообщения;
			Результат.ТекстОшибки = СообщенияИОшибки.ТекстОшибки;
			
			Результат.КоличествоСообщений = Результат.Сообщения.Количество();
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает структуру с результатами последнего запуска регламентного или фонового задания.
// 
// Возвращаемое значение:
//  Структура - структура с информацией о последнем запуске:
//   * ДатаЗапуска - Дата - дата и время запуска
//   * ДатаЗавершения - Дата - дата и время завершения
//   * Состояние - Строка - текстовое описание состояния
//   * КоличествоСообщений - Число - количество сообщений
//   * Длительность - Число - длительность выполнения в секундах
//   * ТекстОшибки - Строка - текст ошибки (если была)
//   * Сообщения - Массив из Строка - массив сообщений
//
&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультатПоследнегоЗапуска()
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаЗапуска", Дата(1, 1, 1));
	Результат.Вставить("ДатаЗавершения", Дата(1, 1, 1));
	Результат.Вставить("Состояние", ТекстСостояниеНеВыполнялось());
	Результат.Вставить("КоличествоСообщений", 0);
	Результат.Вставить("Длительность", 0);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сообщения", Новый Массив);
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОстановитьФоновоеЗаданиеНаСервере(Знач ИдентификаторЗадания)
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	
	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторЗадания));
	Если ФоновоеЗадание = Неопределено Тогда
		ШаблонОшибки = НСтр("ru = 'Фоновое задание по идентификатору %1 не найдено'; en = 'Background task by ID %1 not found'");
		Результат.ТекстОшибки = СтрШаблон(ШаблонОшибки, ИдентификаторЗадания);
		Возврат Результат;
	КонецЕсли;
	
	Если ФоновоеЗадание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
		Результат.ТекстОшибки = ТекстЗаданиеНеАктивно();
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ФоновоеЗадание.Отменить();
		Результат.Успешно = Истина;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Инфо);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.СписокМетаданныеРегламентныхЗаданий.Видимость = Форма.ПоказыватьМетаданные;
	Элементы.ГруппаКнопкиРегламентногоЗадания.Видимость = Форма.ЭтоРегламентноеЗадание;
	Элементы.ГруппаКнопкиСпискаРегламентныхЗаданий.Видимость = НЕ Форма.ЭтоРегламентноеЗадание;
	
	Если Элементы.СтраницыРегламентных.ТекущаяСтраница = Элементы.СтраницаРегламентноеЗадание Тогда
		Элементы.ЗаписатьРегламентноеЗадание.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ЗаписатьРегламентноеЗадание.КнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	
	//@skip-check property-return-type
	НастройкиКонсоли = Форма.НастройкиКонсоли; // Структура
	
	Элементы.ГруппаПроизвольныйИнтервал.Видимость = (Форма.ИнтервалФоновыхЗаданий = 0);
	//@skip-check statement-type-change
	Элементы.СоздатьНовогоПользователяДляРЗ.Видимость = ЗначениеНастройкиКонсоли(
		НастройкиКонсоли, "РазрешитьДобавлениеПользователейРегламентныхЗаданий"
	);
	//@skip-check statement-type-change
	Элементы.СписокРегламентныеЗаданияСледующийЗапуск.Видимость =	ЗначениеНастройкиКонсоли(
		НастройкиКонсоли, "РассчитыватьДатуСледующегоЗапускаРегламентногоЗадания"
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыНастроек(РезультатНастроек, ДополнительныеПараметры) Экспорт
	
	Если РезультатНастроек = Неопределено ИЛИ РезультатНастроек.НастройкиИзменены = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НастройкиКонсоли, РезультатНастроек.Настройки);
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

// Возвращает значение настройки из структуры настроек по ключу.
//
// Параметры:
//   НастройкиКонсоли - Структура - структура настроек консоли
//   КлючНастройки - Строка - ключ искомого свойства
//
// Возвращаемое значение:
//   Произвольный - значение настройки, если найдено
//   Неопределено - если настройка не найдена
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеНастройкиКонсоли(Знач НастройкиКонсоли, Знач КлючНастройки)

	ЗначениеНастройки = Неопределено;
	Если НастройкиКонсоли.Свойство(КлючНастройки, ЗначениеНастройки) Тогда
		Возврат ЗначениеНастройки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

&НаКлиенте 
Функция ПолноеИмяФормы(Знач ИмяВызываемойФормы)
	Возврат СтрЗаменить(ИмяФормы, "ФормаКонсольРегламентныхИФоновыхЗаданий", ИмяВызываемойФормы);
КонецФункции

&НаКлиенте
Асинх Процедура ВернутьсяВСписокРегламентныхЗаданий()
	
	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Настройки регламентного задания были изменены. Сохранить изменения?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, 
			РежимДиалогаВопрос.ДаНет,
			30,
			КодВозвратаДиалога.Нет,
			НСтр("ru = 'Регламентное задание'"),
			КодВозвратаДиалога.Нет
		); // КодВозвратаДиалога
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Если ЗаписатьРегламентноеЗаданиеНаСервере(СвойстваРегламентногоЗадания) Тогда
				Модифицированность = Ложь;
				ОбновитьСписокРегламентныхЗаданий();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоРегламентноеЗадание = Ложь;
	СброситьСвойстваРегламентногоЗадания();
	
	Элементы.СтраницыРегламентных.ТекущаяСтраница = Элементы.ГруппаСписокРегламентныхЗаданий;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСпискиФормы()
	
	ВывестиРегламентныеЗадания();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокПользователейИнформационнойБазы()
	
	СписокПользователей = Новый СписокЗначений;
	
	Попытка
		ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка при получении списка пользователей информационной базы: %1", 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		
		СообщитьПользователю(ТекстОшибки);
		ПользователиИБ = Неопределено;
	КонецПопытки;
	
	Если ПользователиИБ <> Неопределено Тогда
		
		Для Каждого Пользователь Из ПользователиИБ Цикл
			//@skip-check typed-value-adding-to-untyped-collection
			СписокПользователей.Добавить(Пользователь.Имя, Пользователь.ПолноеИмя);
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат СписокПользователей;
	
КонецФункции

&НаСервере
Процедура ВывестиРегламентныеЗадания(Знач ВывестиРезультатПоследнегоЗапуска = Ложь)

	ОбновитьМетаданныеКонфигурации();
	ОбновитьСписокРегламентныхЗаданий(ВывестиРезультатПоследнегоЗапуска);

КонецПроцедуры

&НаКлиенте
Процедура ВывестиФоновыеЗадания()
	
	ОбновитьИнтервалФоновыхЗаданий();
	ОбновитьСписокФоновыхЗаданийНаСервере();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НадписьРасписаниеПоУмолчанию()
	
	Возврат НСтр("ru = 'Расписание не задано'; en = 'No schedule set'");
	
КонецФункции

&НаСервереБезКонтекста
Функция СообщенияОшибкаФоновогоЗадания(ФоновоеЗадание)
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("ТекстОшибки", "");
	
	Для Каждого СообщениеЗадания Из ФоновоеЗадание.ПолучитьСообщенияПользователю(Ложь) Цикл
		Если НЕ ПустаяСтрока(СообщениеЗадания.Текст) Тогда
			Результат.Сообщения.Добавить(СообщениеЗадания.Текст);
		КонецЕсли;
	КонецЦикла;
	
	Если ФоновоеЗадание.ИнформацияОбОшибке <> Неопределено Тогда
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаданиеПоИдентификатору(Знач ИдентификаторЗадания)
	
	ТекущееРегламентноеЗадание = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗадания) ИЛИ ТипЗнч(ИдентификаторЗадания) <> Тип("УникальныйИдентификатор") Тогда
		Возврат ТекущееРегламентноеЗадание; 
	КонецЕсли;
	
	Попытка
		ТекущееРегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Исключение
		ТекущееРегламентноеЗадание = Неопределено;
	КонецПопытки;
	
	Возврат ТекущееРегламентноеЗадание;
	
КонецФункции

