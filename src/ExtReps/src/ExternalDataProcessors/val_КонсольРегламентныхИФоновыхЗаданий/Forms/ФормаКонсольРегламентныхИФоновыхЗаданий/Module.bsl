#Область ОписаниеПеременных

// Расписание регламентного задания 
&НаКлиенте
Перем Расписание; // РасписаниеРегламентногоЗадания

&НаКлиенте
Перем СвойстваРегламентногоЗадания; // Структура - содержит свойства регламентного задания

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();
	
	Элементы.Задание_Пользователь.КартинкаКнопкиВыбора = БиблиотекаКартинок.Обновить;
	
	ПоказыватьМетаданные = Ложь;
	ПоказыватьФоновыхЗаданий = 50;
	ИнтервалФоновыхЗаданий = 15;
	ФоновоеЗадание_Активно = Истина;
	ФоновоеЗадание_ЗавершеноАварийно = Истина;
	
	ЦветНажатойКнопки = ЦветаСтиля.ЦветНавигации;
	ЦветОбычнойКнопки = ЦветаСтиля.ЦветФонаКнопки;
	
	Элементы.НадписьРасписание.Заголовок = НадписьРасписаниеПоУмолчанию();
	
	ИнициализироватьНастройкиКонсоли();
	
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьИнтервалФоновыхЗаданий();
	ПодключитьОбработчикОжидания("ОбновитьСпискиФормы", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтоРегламентноеЗадание Тогда
		Отказ = Истина;
		ВернутьсяВСписокРегламентныхЗаданий();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДобавленПользовательИБ" Или ИмяСобытия = "ИзмененПользовательИБ" Тогда
		
		ПослеСозданияПользователя(Источник.Объект.Ссылка);

	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Открывает форму изменения расписания задания.
//
// Параметры:
//   Элемент - ДекорацияФормы - элемент формы, вызвавший обработчик
//   СтандартнаяОбработка - Булево - признак выполнения стандартной обработки
//
&НаКлиенте
Процедура НадписьРасписаниеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИзменитьРасписаниеЗадания();
	
КонецПроцедуры

