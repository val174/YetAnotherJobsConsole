	УстановитьСвойствоРегламентногоЗадания("Метаданные", Задание_Метаданные);
	
	Задание_Метод = МетодРегламентногоЗадания(Задание_Метаданные);
	ЗаполнитьПараметрыРегламентногоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура Задание_НаименованиеПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("Наименование", Задание_Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура Задание_КоличествоПовторовПриАварийномЗавершенииПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("КоличествоПовторовПриАварийномЗавершении", Задание_КоличествоПовторовПриАварийномЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура Задание_ИнтервалПовтораПриАварийномЗавершенииПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("ИнтервалПовтораПриАварийномЗавершении", Задание_ИнтервалПовтораПриАварийномЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура Задание_КлючПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("Ключ", Задание_Ключ);

КонецПроцедуры

&НаКлиенте
Процедура Задание_ПользовательПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("ИмяПользователя", Задание_Пользователь);

КонецПроцедуры

&НаКлиенте
Процедура Задание_ПользовательНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбора = Элементы.Задание_Пользователь.СписокВыбора;
	СписокВыбора.Очистить();
	
	ПользователиИБ = СписокПользователейИнформационнойБазы();
	Для Каждого ЭлементСписка Из ПользователиИБ Цикл
		СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Задание_ВключеноПриИзменении(Элемент)
	
	Модифицированность = Истина;
	УстановитьСвойствоРегламентногоЗадания("Использование", Задание_Использование);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалФоновыхЗаданийПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();

КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗадание_АктивноПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗадание_ЗавершеноАварийноПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗадание_ЗавершеноПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗадание_ОтмененоПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборФоновыхПоРегламентномуЗаданиюПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьФоновыхЗаданийПриИзменении(Элемент)
	
	ВывестиФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаИзбранноеНажатие(Элемент)
	
	ТекущиеДанные = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Задание_Избранное = НЕ Задание_Избранное;
	
	ИзменитьСписокИзбранного(Задание_Метаданные, Задание_Избранное);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокМетаданныеРегламентныхЗаданий

&НаКлиенте
Процедура СписокМетаданныеРегламентныхЗаданийПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборРегламентныхЗаданийПоМетаданным();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокРегламентныеЗадания

&НаКлиенте
Процедура СписокРегламентныеЗаданияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СписокРегламентныеЗаданияРасписание Тогда
		
		Задание_Идентификатор = СтрокаТаблицы.Идентификатор; // УникальныйИдентификатор
		Расписание = Неопределено;
		УстановитьСвойствоРегламентногоЗадания("УникальныйИдентификатор", Задание_Идентификатор);
		ИзменитьРасписаниеЗадания(Истина);
		
	Иначе
		
		ЗаполнитьСвойстваРегламентногоЗадания(СтрокаТаблицы.ПолучитьИдентификатор());
	
		Элементы.СтраницыРегламентных.ТекущаяСтраница = Элементы.СтраницаРегламентноеЗадание;
		ЭтоРегламентноеЗадание = Истина;
		УправлениеФормой(ЭтотОбъект);
		
	КонецЕсли;

КонецПроцедуры

//@skip-check property-return-type
//@skip-check invocation-parameter-type-intersect
&НаКлиенте
Процедура СписокРегламентныеЗаданияПриАктивизацииСтроки(Элемент)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПоследнегоЗапуска = РезультатПоследнегоЗапуска(СтрокаТаблицы.Идентификатор);
	Если РезультатПоследнегоЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы.ДатаЗапуска = РезультатПоследнегоЗапуска.ДатаЗапуска;
	СтрокаТаблицы.Состояние = РезультатПоследнегоЗапуска.Состояние;
	СтрокаТаблицы.ТекстОшибки = РезультатПоследнегоЗапуска.ТекстОшибки;
	СтрокаТаблицы.ЗавершеноСОшибками = НЕ ПустаяСтрока(РезультатПоследнегоЗапуска.ТекстОшибки);
	
	Если СтрокаТаблицы.Использование И НастройкиКонсоли.РассчитыватьДатуСледующегоЗапускаРегламентногоЗадания Тогда
		Расписание = РасписаниеПоУмолчанию(СтрокаТаблицы.Идентификатор);
		СтрокаТаблицы.СледующийЗапуск = ДатаСледующегоЗапускаРегламентногоЗадания(Расписание, СтрокаТаблицы.Использование, РезультатПоследнегоЗапуска);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СписокРегламентныеЗаданияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	УдалитьТекущееЗадание();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПараметрыРегламентногоЗадания

&НаКлиенте
Процедура ПараметрыРегламентногоЗаданияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаТаблицы = Элементы.ПараметрыРегламентногоЗадания.ТекущиеДанные;
	
	Если СтрокаТаблицы.ТипПараметра = Новый ОписаниеТипов("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		
		ЗначениеПараметра = СтрокаТаблицы.Значение;
		СтруктураПараметров = Новый Структура("ИсходнаяСтруктура", ЗначениеПараметра);
		
		ДопПараметры = Новый Структура("ИДСтроки", СтрокаТаблицы.ПолучитьИдентификатор());
		
		Оповещение = Новый ОписаниеОповещения("ПослеРедактированияСтруктуры", ЭтотОбъект, ДопПараметры);
		
		ИмяФормыРедактора = ПолноеИмяФормы("ФормаРедактированияСтруктуры");
		
		ОткрытьФорму(ИмяФормыРедактора, СтруктураПараметров, ЭтотОбъект, , , , 
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыРегламентногоЗаданияЗначениеПриИзменении(Элемент)
	
	УстановитьСвойствоРегламентногоЗадания("Параметры", ПараметрыЗаданияВВМассив());
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыРегламентногоЗаданияТипПараметраНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаТаблицы = Элементы.ПараметрыРегламентногоЗадания.ТекущиеДанные;
		
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИсходноеОписаниеТипов", СтрокаТаблицы.ТипПараметра);
	
	ПараметрыОбработкиВыбора = Новый Структура("ИДСтроки", СтрокаТаблицы.ПолучитьИдентификатор());
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаЗначения", ЭтотОбъект, ПараметрыОбработкиВыбора);
	
	ИмяФормыРедактора = ПолноеИмяФормы("ФормаВыборТипаЗначения");
	ОткрытьФорму(ИмяФормыРедактора, СтруктураПараметров, ЭтотОбъект, , , , 
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерейтиВСписокРегламентныхЗаданий(Команда)
	
	ВернутьсяВСписокРегламентныхЗаданий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьМетаданныеРегламентныхЗаданий(Команда)

	ПоказыватьМетаданные = НЕ ПоказыватьМетаданные;
	
	ИзменитьПометкуКнопки("ПоказыватьМетаданныеРегламентныхЗаданий", ПоказыватьМетаданные);
	
	Если ПоказыватьМетаданные И СписокМетаданныеРегламентныхЗаданий.Количество() = 0 Тогда
		ОбновитьМетаданныеКонфигурации();
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	УстановитьОтборРегламентныхЗаданийПоМетаданным();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРегламентноеЗадание(Команда)
	
	ЭтоРегламентноеЗадание = Истина;
	ЭтоДобавлениеЗадания = Истина;
	
	СтрокаТаблицы = Элементы.СписокМетаданныеРегламентныхЗаданий.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		Задание_Метаданные = СтрокаТаблицы.Имя;
		
		УстановитьСвойствоРегламентногоЗадания("Метаданные", Задание_Метаданные);
		
		Модифицированность = Истина;
	Иначе
		ОбновитьМетаданныеКонфигурации(Истина);
	КонецЕсли;
	
	УстановитьСвойствоРегламентногоЗадания("УникальныйИдентификатор", Неопределено);
	
	Элементы.СтраницыРегламентных.ТекущаяСтраница = Элементы.СтраницаРегламентноеЗадание;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура УдалитьРегламентноеЗадание(Команда)
	
	УдалитьТекущееЗадание();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРегламентноеЗадание(Команда)
	
	Если СвойстваРегламентногоЗадания = Неопределено ИЛИ НЕ Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СвойстваРегламентногоЗадания.Свойство("УникальныйИдентификатор") Тогда
		СвойстваРегламентногоЗадания.Вставить("УникальныйИдентификатор", Задание_Идентификатор);
	КонецЕсли;
	
	Если ЗаписатьРегламентноеЗаданиеНаСервере(СвойстваРегламентногоЗадания) Тогда
		ОбновитьСписокРегламентныхЗаданий();
		Модифицированность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьРегламентныеЗадания(Команда)
	
	ВключитьВыключитьРегламентныеЗадания(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВыключитьРегламентныеЗадания(Команда)
	
	ВключитьВыключитьРегламентныеЗадания(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокРегламентныеЗадания(Команда)
	
	ВывестиРегламентныеЗадания(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйФильтр_Избранное(Команда)

	ИзменитьПометкуКнопки("БыстрыйФильтр_Избранное", НЕ Элементы.БыстрыйФильтр_Избранное.Пометка);
	
	Если Элементы.БыстрыйФильтр_Избранное.Пометка Тогда
		ИзменитьПометкуКнопки("БыстрыйФильтр_Активные", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_СОшибками", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_Включенные", Ложь);
		
		ОбновитьСписокРегламентныхЗаданий(Истина);
	КонецЕсли;
	
	УстановитьБыстрыеФильтры();

КонецПроцедуры

&НаКлиенте
Процедура БыстрыйФильтр_Активные(Команда)
	
	ИзменитьПометкуКнопки("БыстрыйФильтр_Активные", НЕ Элементы.БыстрыйФильтр_Активные.Пометка);
	
	Если Элементы.БыстрыйФильтр_Активные.Пометка Тогда
		ИзменитьПометкуКнопки("БыстрыйФильтр_Избранное", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_СОшибками", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_Включенные", Ложь);
		
		ОбновитьСписокРегламентныхЗаданий(Истина);
	КонецЕсли;
	
	УстановитьБыстрыеФильтры();
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйФильтр_Включенные(Команда)
	
	ИзменитьПометкуКнопки("БыстрыйФильтр_Включенные", НЕ Элементы.БыстрыйФильтр_Включенные.Пометка);
	
	Если Элементы.БыстрыйФильтр_Включенные.Пометка Тогда
		ИзменитьПометкуКнопки("БыстрыйФильтр_Избранное", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_СОшибками", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_Активные", Ложь);
	КонецЕсли;
	
	УстановитьБыстрыеФильтры();
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйФильтр_СОшибками(Команда)
	
	ИзменитьПометкуКнопки("БыстрыйФильтр_СОшибками", НЕ Элементы.БыстрыйФильтр_СОшибками.Пометка);
	
	Если Элементы.БыстрыйФильтр_СОшибками.Пометка Тогда
		ИзменитьПометкуКнопки("БыстрыйФильтр_Избранное", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_Включенные", Ложь);
		ИзменитьПометкуКнопки("БыстрыйФильтр_Активные", Ложь);
		
		ОбновитьСписокРегламентныхЗаданий(Истина);
	КонецЕсли;
	
	УстановитьБыстрыеФильтры();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокФоновыхЗаданий(Команда)
	
	ВывестиФоновыеЗадания();

КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьСписокВключенныхРегламентныхЗаданий(Команда)

	МассивЗаданий = СохранитьСписокРегламентныхЗаданийНаСервере();
	Если МассивЗаданий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДлгВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	
	ДлгВыбораФайла.МножественныйВыбор = Ложь;
	ДлгВыбораФайла.Заголовок = НСтр("ru = 'Выбор файла'");
	ДлгВыбораФайла.Фильтр = "Файл выгрузки РЗ(*.json)|*.json";
	ДлгВыбораФайла.ИндексФильтра = 0;
	
	РезультатВыбора = Ждать ДлгВыбораФайла.ВыбратьАсинх();
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстJSON = Новый ТекстовыйДокумент;
	ТекстJson.УстановитьТекст(вJSON(МассивЗаданий));
	ТекстJSON.ЗаписатьАсинх(РезультатВыбора[0]);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьСписокВключенныхРегламентныхЗаданий(Команда)
	
	ДлгВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДлгВыбораФайла.МножественныйВыбор = Ложь;
	ДлгВыбораФайла.Заголовок = НСтр("ru = 'Выбор файла'");
	ДлгВыбораФайла.Фильтр = "Файл выгрузки РЗ(*.json)|*.json";
	ДлгВыбораФайла.ИндексФильтра = 0;
	
	РезультатВыбора = Ждать ДлгВыбораФайла.ВыбратьАсинх();
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстJSON = Новый ТекстовыйДокумент;
	ТекстJSON.Прочитать(РезультатВыбора[0]);
	
	МассивЗаданий = изJSON(ТекстJSON.ПолучитьТекст());
	Если МассивЗаданий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВключитьРегламентныеЗаданияИзФайла(МассивЗаданий);
	ОбновитьСписокРегламентныхЗаданий();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗапуститьЗаданиеВТекущемСеансе(Команда)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Ждать ВопросАсинх("Запустить выполнение задания в текущем сеансе?",
		РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет, "Запуск рег. задания", КодВозвратаДиалога.Нет);
		
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьЗаданиеВТекущемСеансеНаСервере(СтрокаТаблицы.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗапуститьЗаданиеВФоновомЗадании(Команда)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Ждать ВопросАсинх("Запустить выполнение задания в фоне?",
		РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет, "Запуск рег. задания", КодВозвратаДиалога.Нет); // КодВозвратаДиалога
		
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьЗаданиеВФоновомЗаданииНаСервере(СтрокаТаблицы.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКФоновымЗаданиям(Команда)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборФоновых_РегламентноеЗадание = СтрокаТаблицы.Идентификатор;
	
	ВывестиФоновыеЗадания();
	Элементы.СтраницыЗаданий.ТекущаяСтраница = Элементы.СтраницаФоновыеЗадания;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период.Вариант = ВариантСтандартногоПериода.Сегодня;
	Диалог.Период.ДатаНачала = ДатаНачала;
	Диалог.Период.ДатаОкончания = ДатаОкончания;
	
	ВыбранныйПериод = Ждать Диалог.РедактироватьАсинх();
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачала = ВыбранныйПериод.ДатаНачала;
	ДатаОкончания = ВыбранныйПериод.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЖурналРегистрации(Команда)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		ПредупреждениеАсинх(НСтр("ru = 'Выберите регламентное задание.'"), 30, НСтр("ru = 'Журнал регистрации'"));
		Возврат;
	КонецЕсли;
	
	ПодключитьСтандартныйЖурналРегистрацииНаСервере();
	ПараметрыЖурнала = Новый Структура;
	ПараметрыЖурнала.Вставить("User", СтрокаТаблицы.Пользователь);
	//@skip-check bsl-legacy-check-string-literal
	ОткрытьФорму("ВнешняяОбработка.StandardEventLog.Форма", ПараметрыЖурнала);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОстановитьФоновоеЗадание(Команда)
	
	СтрокаТаблицы = Элементы.СписокФоновыеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаголовокСобытия = НСтр("ru = 'Остановка фонового задания'; en = 'Stopping a background task'");
	
	Если СтрокаТаблицы.Состояние <> ТекстСостояниеВыполняется() Тогда
		Ждать ПредупреждениеАсинх(ТекстЗаданиеНеАктивно(), 30, ЗаголовокСобытия);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Вы хотите остановить фоновое задание?';
						|en = 'Do you want to stop the selected background task'");
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		30,
		КодВозвратаДиалога.Нет,
		ЗаголовокСобытия,
		КодВозвратаДиалога.Нет
	);
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОстановитьФоновоеЗаданиеНаСервере(СтрокаТаблицы.Идентификатор);
	Если Результат.Успешно Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Задание останавливается'; en = 'The tasks stops'")
		
	Иначе
		
		ТекстПредупреждения = Результат.ТекстОшибки;
		
	КонецЕсли;
	
	ПредупреждениеАсинх(ТекстПредупреждения, 60, ЗаголовокСобытия);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СоздатьНовогоПользователяДляРЗ(Команда)
	
	ТекстВопроса = НСтр("ru = 'Создать нового пользователя для задания?'; en = 'Create a new user for the task?'");
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяНовогоПользователя = СтрЗаменить(Задание_Метаданные, НастройкиКонсоли.ПрефиксМетаданных, "");
	ИмяНовогоПользователя = СтрШаблон("%1_%2", НастройкиКонсоли.ПрефиксИмениПользователяРЗ, ИмяНовогоПользователя);
		
	Если Лев(ИмяНовогоПользователя, 1) = "_" Тогда
		ИмяНовогоПользователя = Сред(ИмяНовогоПользователя, 2);
	КонецЕсли;
	
	ИменаМетаданных = ИменаЛокализованныхМетаданных();
	
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияПользователя", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	
	Если ЕстьПодсистемаПользователи(ИменаМетаданных) Тогда
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Наименование", ИмяНовогоПользователя);
		
    	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);		
		
		ИмяФормыСоздания = СтрШаблон("Справочник.%1.ФормаОбъекта", ИменаМетаданных.СправочникПользователи);
	
	Иначе
		
		СвойстваМетаданных = СвойстваМетаданныхКонфигурации();
				
		ПараметрыФормы.Вставить("Clone", True);
		ПараметрыФормы.Вставить("NewName", ИмяНовогоПользователя);
		ПараметрыФормы.Вставить("UUID", "");
		
		ПараметрыФормы.Вставить("DataSeparators", СвойстваМетаданных.DataSeparators);
		ПараметрыФормы.Вставить("Languages", СвойстваМетаданных.Languages);
		ПараметрыФормы.Вставить("Roles", СвойстваМетаданных.Roles);
		
		ПодключитьСтандартныйСписокПользователей();
		
		ИмяФормыСоздания = "ВнешняяОбработка.StandardUserList.Форма.User";		
		
	КонецЕсли;
	
	//@skip-check bsl-legacy-check-string-literal
	ОткрытьФорму(ИмяФормыСоздания, ПараметрыФормы, ЭтотОбъект,,,, Оповещение,
			 РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиКонсоли(Команда)
	
	ИмяФормыРедактора = ПолноеИмяФормы("ФормаНастройкиКонсоли");
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыНастроек", ЭтотОбъект);
	
	//@skip-check invocation-parameter-type-intersect
	ОткрытьФорму(ИмяФормыРедактора, НастройкиКонсоли, ЭтотОбъект, , , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВИзбранное(Команда)
	
	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьСписокИзбранного(СтрокаТаблицы.Метаданные, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзИзбранного(Команда)

	СтрокаТаблицы = Элементы.СписокРегламентныеЗадания.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьСписокИзбранного(СтрокаТаблицы.Метаданные, Ложь);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ИзменитьРасписаниеКонтекст(Команда)
	
	ИДЗаданий = Новый Массив;
	Для Каждого ИдСтроки Из Элементы.СписокРегламентныеЗадания.ВыделенныеСтроки Цикл
		СтрокаТаблицы = СписокРегламентныеЗадания.НайтиПоИдентификатору(ИдСтроки);
		ИДЗаданий.Добавить(СтрокаТаблицы.Идентификатор);
	КонецЦикла;
	
	Если ИДЗаданий.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'Не выбрано ни одного задания'; en = 'No jobs selected'"));
		Возврат;
	КонецЕсли;
	
	Задание_Идентификатор = ИДЗаданий[0];
	
	ИзменитьРасписаниеЗадания(Истина, ИДЗаданий);
	
КонецПроцедуры

#КонецОбласти

//@skip-check module-structure-top-region
#Область СлужебныеПроцедурыФункции

#Область СохранениеЗагрузкаВключенных

&НаСервереБезКонтекста
Функция вJSON(Знач Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(
			, // ПереносСтрок
			Символы.Таб, // СимволыОтступа
			, // ИспользоватьДвойныеКавычки
			ЭкранированиеСимволовJSON.СимволыВнеBMP, // ЭкранированиеСимволов
			Истина, // ЭкранироватьУгловыеСкобки
			Истина, // ЭкранироватьРазделителиСтрок
			Истина, // ЭкранироватьАмперсанд
			Истина, // ЭкранироватьОдинарныеКавычки
			Истина); // ЭкранироватьСлеш
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Результат = ЗаписьJSON.Закрыть();
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция изJSON(Знач Текст, Знач ВСоответствие = Ложь)
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(ЧтениеJSON, ВСоответствие);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция СохранитьСписокРегламентныхЗаданийНаСервере()
	
	МассивЗаданий = Новый Массив;
	
	Отбор = Новый Структура("Использование", Истина);
	ВключенныеЗадания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	Для каждого Задание Из ВключенныеЗадания Цикл
		
		МассивЗаданий.Добавить(Строка(Задание.УникальныйИдентификатор));
		
	КонецЦикла;
	
	Возврат МассивЗаданий;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ВключитьРегламентныеЗаданияИзФайла(МассивЗаданий)
	
	Для каждого ИДЗадания Из МассивЗаданий Цикл
		
		УИДЗадания = Новый УникальныйИдентификатор(ИДЗадания);
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(УИДЗадания);
		Если Задание <> Неопределено Тогда
			Задание.Использование = Истина;
			Задание.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УсловноеОформление

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Оформление_ЗавершеноСОшибками = Новый Структура;
	Оформление_ЗавершеноСОшибками.Вставить("ЦветТекста", ЦветТекста_ВажнаяНадпись());
	
	Оформление_Полужирный = Новый Структура;
	Оформление_Полужирный.Вставить("Шрифт", ШрифтТекста_Полужирный());
	
	ОформляемыеПоля = Новый Массив;
	ОформляемыеПоля.Добавить("СписокРегламентныеЗаданияСостояние");
	ОформляемыеПоля.Добавить("СписокРегламентныеЗаданияНаименование");
	
	ДобавитьУсловноеОформление(ОформляемыеПоля, Оформление_ЗавершеноСОшибками, "СписокРегламентныеЗадания.ЗавершеноСОшибками", Истина);
	
	ОформляемыеПоля.Добавить("СписокРегламентныеЗаданияДатаЗапуска");
	
	ДобавитьУсловноеОформление(ОформляемыеПоля, Оформление_Полужирный, "СписокРегламентныеЗадания.Состояние", ТекстСостояниеВыполняется());
	
КонецПроцедуры

// Добавляет условное оформление элементов формы
//
// Параметры:
//  Поля           - Строка, Массив - строка или массив строк с именами оформляемых полей
//  Оформление     - Структура - ключ - имя параметра условного оформления, значение - значение параметра
//  ЛевоеЗначение  - Строка - левое значение элемента отбора
//  ПравоеЗначение - Произвольный - правое значение элемента отбора
//  ВидСравнения   - ВидСравненияКомпоновкиДанных - способ сравнения, используемый при фильтрации по элементу отбора
//
&НаСервере
Процедура ДобавитьУсловноеОформление(Знач Поля, Знач Оформление, Знач ЛевоеЗначение, Знач ПравоеЗначение, Знач ВидСравнения = Неопределено)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		Поля = ЗначениеВМассив(Поля);
	КонецЕсли;
	
	Для Каждого Поле Из Поля Цикл 
			
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Поле);
		
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
	Если ЗначениеЗаполнено(ВидСравнения) Тогда
		ОтборЭлемента.ВидСравнения = ВидСравнения;
	КонецЕсли;
	ОтборЭлемента.ПравоеЗначение = ПравоеЗначение;
	
	Для Каждого ЭлементОформления Из Оформление Цикл 
		Элемент.Оформление.УстановитьЗначениеПараметра(ЭлементОформления.Ключ, ЭлементОформления.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
