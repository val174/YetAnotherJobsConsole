#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"ОтборФоновых_ИмяМетода, ОтборФоновых_Ключ, ОтборФоновых_Наименование,
		| ОтборФоновых_РегламентноеЗадание, ИнтервалФоновыхЗаданий, ДатаНачала, ДатаОкончания,
		| ФоновоеЗадание_Активно, ФоновоеЗадание_Завершено,
		| ФоновоеЗадание_ЗавершеноАварийно, ФоновоеЗадание_Отменено");
	
	ЗаполнитьСпискиВыбора();
	ЗаполнитьСпискиИнтервала();
	
	Элементы.ГруппаПроизвольныйИнтервал.Видимость = (ИнтервалФоновыхЗаданий = 0);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИнтервалФоновыхЗаданийПриИзменении(Элемент)
	
	Элементы.ГруппаПроизвольныйИнтервал.Видимость = (ИнтервалФоновыхЗаданий = 0);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрименитьОтбор(Команда)
	
	Закрыть(ТекущийОтбор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтбор(Команда)
	
	ОтборФоновых_ИмяМетода = "";
	ОтборФоновых_Ключ = "";
	ОтборФоновых_Наименование = "";
	ОтборФоновых_РегламентноеЗадание = "";
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период.Вариант = ВариантСтандартногоПериода.Сегодня;
	Диалог.Период.ДатаНачала = ДатаНачала;
	Диалог.Период.ДатаОкончания = ДатаОкончания;
	
	ВыбранныйПериод = Ждать Диалог.РедактироватьАсинх();
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачала = ВыбранныйПериод.ДатаНачала;
	ДатаОкончания = ВыбранныйПериод.ДатаОкончания;
	ИнтервалФоновыхЗаданий = 0;
	Элементы.ГруппаПроизвольныйИнтервал.Видимость = (ИнтервалФоновыхЗаданий = 0);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значения отборов, заданные на форме.
//
// Возвращаемое значение:
//   Структура - значения отборов фоновых заданий
//
&НаКлиенте
Функция ТекущийОтбор()
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОтборФоновых_ИмяМетода", ОтборФоновых_ИмяМетода);
	Отбор.Вставить("ОтборФоновых_Ключ", ОтборФоновых_Ключ);
	Отбор.Вставить("ОтборФоновых_Наименование", ОтборФоновых_Наименование);
	Отбор.Вставить("ОтборФоновых_РегламентноеЗадание", ОтборФоновых_РегламентноеЗадание);
	Отбор.Вставить("ИнтервалФоновыхЗаданий", ИнтервалФоновыхЗаданий);
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	Отбор.Вставить("ФоновоеЗадание_Активно", ФоновоеЗадание_Активно);
	Отбор.Вставить("ФоновоеЗадание_Завершено", ФоновоеЗадание_Завершено);
	Отбор.Вставить("ФоновоеЗадание_ЗавершеноАварийно", ФоновоеЗадание_ЗавершеноАварийно);
	Отбор.Вставить("ФоновоеЗадание_Отменено", ФоновоеЗадание_Отменено);
	
	Возврат Отбор;
	
КонецФункции

// Заполняет списки выбора интервала и количества выводимых заданий.
//
&НаСервере
Процедура ЗаполнитьСпискиИнтервала()
	
	СписокИнтервалов = Элементы.ИнтервалФоновыхЗаданий.СписокВыбора;
	СписокИнтервалов.Очистить();
	
	СписокИнтервалов.Добавить(5, НСтр("ru = 'Последние 5 минут'; en = 'Last 5 minutes'"));
	СписокИнтервалов.Добавить(15, НСтр("ru = 'Последние 15 минут'; en = 'Last 15 minutes'"));
	СписокИнтервалов.Добавить(30, НСтр("ru = 'Последние 30 минут'; en = 'Last 30 minutes'"));
	СписокИнтервалов.Добавить(60, НСтр("ru = 'Последний час'; en = 'Last hour'"));
	СписокИнтервалов.Добавить(180, НСтр("ru = 'Последние 3 часа'; en = 'Last 3 hours'"));
	СписокИнтервалов.Добавить(360, НСтр("ru = 'Последние 6 часов'; en = 'Last 6 hours'"));
	СписокИнтервалов.Добавить(720, НСтр("ru = 'Последние 12 часов'; en = 'Last 12 hours'"));
	СписокИнтервалов.Добавить(1440, НСтр("ru = 'Последние 24 часа'; en = 'Last 24 hours'"));
	СписокИнтервалов.Добавить(2880, НСтр("ru = 'Последние 2 дня'; en = 'Last 2 days'"));
	СписокИнтервалов.Добавить(4320, НСтр("ru = 'Последние 3 дня'; en = 'Last 3 days'"));
	СписокИнтервалов.Добавить(0, НСтр("ru = 'Произвольный интервал'; en = 'Custom range'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	СписокМетодов = Элементы.ОтборФоновых_ИмяМетода.СписокВыбора;
	СписокМетодов.Очистить();
	
	СписокЗаданий = Элементы.ОтборФоновых_РегламентноеЗадание.СписокВыбора;
	СписокЗаданий.Очистить();
	
	ИменаМетодов = Новый Массив;
	Для Каждого МетаданныеЗадания Из Метаданные.РегламентныеЗадания Цикл
		Если ИменаМетодов.Найти(МетаданныеЗадания.ИмяМетода) = Неопределено Тогда
			ИменаМетодов.Добавить(МетаданныеЗадания.ИмяМетода);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		//@skip-check typed-value-adding-to-untyped-collection
		СписокМетодов.Добавить(ИмяМетода);
	КонецЦикла;
	
	Попытка
		МассивЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Исключение
		МассивЗаданий = Новый Массив;
	КонецПопытки;
	
	Для Каждого РегламентноеЗадание Из МассивЗаданий Цикл
		ПредставлениеЗадания = РегламентноеЗадание.Наименование;
		Если ПустаяСтрока(ПредставлениеЗадания) Тогда
			ПредставлениеЗадания = ?(ПустаяСтрока(РегламентноеЗадание.Метаданные.Синоним),
				 РегламентноеЗадание.Метаданные.Имя,
				 РегламентноеЗадание.Метаданные.Синоним
			);	
		КонецЕсли;
		
		//@skip-check typed-value-adding-to-untyped-collection
		СписокЗаданий.Добавить(Строка(РегламентноеЗадание.УникальныйИдентификатор), ПредставлениеЗадания);
	КонецЦикла;
	
	СписокЗаданий.СортироватьПоПредставлению();
	
КонецПроцедуры

#КонецОбласти
