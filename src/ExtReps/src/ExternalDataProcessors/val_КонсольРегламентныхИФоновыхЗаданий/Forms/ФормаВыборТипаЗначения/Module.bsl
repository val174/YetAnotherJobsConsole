#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДоступныеТипы(Параметры.ТолькоПростыеТипы = Истина);
	ЗаполнитьКвалификаторыПоУмолчанию();
	ЗаполнитьСписокЧастейДаты();
	ОбновитьВидимостьКвалификаторовНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоТипов

&НаКлиенте
Процедура ДеревоТиповВыбранПриИзменении(Элемент)
	
	ОбновитьВидимостьКвалификаторов();
	
	ТекущийУзел = Элементы.ДеревоТипов.ТекущиеДанные;
	Если ТекущийУзел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппаУзла(ТекущийУзел.ИмяТипа) Тогда
		УстановитьОтметкуГруппыНаСервере(ТекущийУзел.ИмяТипа, ТекущийУзел.Выбран);
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийУзел.ЭтоКонтейнер Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийУзел.Выбран Тогда
		ОчиститьТипЭлементаНаСервере(ТекущийУзел.ИмяТипа);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаЭлемента", ЭтотОбъект, ТекущийУзел.ИмяТипа);
	
	СтруктураПараметров = Новый Структура("ТолькоПростыеТипы", Истина);
	
	ОткрытьФорму(ИмяФормы, СтруктураПараметров, ЭтотОбъект, Истина, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьТип(Команда)
	
	Результат = ПодготовитьРезультатНаСервере();
	
	Если Результат.Свойство("ТекстОшибки") Тогда
		ПоказатьПредупреждение(Неопределено, Результат.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыбор(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДоступныеТипы(Знач ТолькоПростыеТипы)
	
	ДеревоТипов.ПолучитьЭлементы().Очистить();
	
	ДобавитьУзелТипа(Неопределено, "Число", НСтр("ru = 'Число'; en = 'Number'"));
	ДобавитьУзелТипа(Неопределено, "Строка", НСтр("ru = 'Строка'; en = 'String'"));
	ДобавитьУзелТипа(Неопределено, "Дата", НСтр("ru = 'Дата'; en = 'Date'"));
	ДобавитьУзелТипа(Неопределено, "Булево", НСтр("ru = 'Булево'; en = 'Boolean'"));
	
	// Тип элемента контейнера не может быть контейнером, иначе вложенность была бы неограниченной.
	Если НЕ ТолькоПростыеТипы Тогда
		ДобавитьУзелТипа(Неопределено, "СписокЗначений", НСтр("ru = 'Список значений'; en = 'Value list'"), Истина);
		ДобавитьУзелТипа(Неопределено, "Массив", НСтр("ru = 'Массив'; en = 'Array'"), Истина);
	КонецЕсли;
	
	ДобавитьУзелТипа(Неопределено, "Структура", НСтр("ru = 'Структура'; en = 'Structure'"));
	
	ДобавитьГруппуСсылочныхТипов(НСтр("ru = 'Справочники'; en = 'Catalogs'"), Метаданные.Справочники,
		"СправочникСсылка.");
	ДобавитьГруппуСсылочныхТипов(НСтр("ru = 'Документы'; en = 'Documents'"), Метаданные.Документы,
		"ДокументСсылка.");
	ДобавитьГруппуСсылочныхТипов(НСтр("ru = 'Перечисления'; en = 'Enums'"), Метаданные.Перечисления,
		"ПеречислениеСсылка.");
	ДобавитьГруппуСсылочныхТипов(НСтр("ru = 'Планы видов характеристик'; en = 'Charts of characteristic types'"), Метаданные.ПланыВидовХарактеристик,
		"ПланВидовХарактеристикСсылка.");
	
КонецПроцедуры

&НаСервере
Функция ДобавитьУзелТипа(Родитель, Знач ИмяТипа, Знач Представление, Знач ЭтоКонтейнер = Ложь)
	
	Если Родитель = Неопределено Тогда
		Узел = ДеревоТипов.ПолучитьЭлементы().Добавить();
	Иначе
		Узел = Родитель.ПолучитьЭлементы().Добавить();
	КонецЕсли;
	
	Узел.ИмяТипа = ИмяТипа;
	Узел.Представление = Представление;
	Узел.ЭтоКонтейнер = ЭтоКонтейнер;
	Узел.Выбран = Ложь;
	Узел.Тип = Новый ОписаниеТипов();
	
	Возврат Узел;
	
КонецФункции

&НаСервере
Процедура ДобавитьГруппуСсылочныхТипов(Знач НаименованиеГруппы, КоллекцияМетаданных,
	Знач ПрефиксТипа)
	
	Если КоллекцияМетаданных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УзелГруппы = ДобавитьУзелТипа(Неопределено, ПрефиксГруппы() + НаименованиеГруппы, НаименованиеГруппы);
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		ДобавитьУзелТипа(УзелГруппы,
			ПрефиксТипа + ОбъектМетаданных.Имя,
			ПредставлениеОбъектаМетаданных(ОбъектМетаданных));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиУзелПоИмениТипа(Узлы, Знач ИмяТипа)
	
	Для Каждого Узел Из Узлы Цикл
		
		Если Узел.ИмяТипа = ИмяТипа Тогда
			Возврат Узел;
		КонецЕсли;
		
		НайденныйУзел = НайтиУзелПоИмениТипа(Узел.ПолучитьЭлементы(), ИмяТипа);
		Если НайденныйУзел <> Неопределено Тогда
			Возврат НайденныйУзел;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура УстановитьОтметкуГруппыНаСервере(Знач ИмяТипа, Знач Отметка)
	
	Узел = НайтиУзелПоИмениТипа(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтметкуВложенным(Узел.ПолучитьЭлементы(), Отметка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкуВложенным(Узлы, Знач Отметка)
	
	Для Каждого Узел Из Узлы Цикл
		Узел.Выбран = Отметка;
		УстановитьОтметкуВложенным(Узел.ПолучитьЭлементы(), Отметка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТипЭлементаНаСервере(Знач ИмяТипа, ОписаниеТипаЭлемента)
	
	Узел = НайтиУзелПоИмениТипа(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Узел.Выбран = Истина;
	Узел.Тип = ОписаниеТипаЭлемента;
	Узел.Представление = ПредставлениеКонтейнера(ИмяТипа, ОписаниеТипаЭлемента);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТипЭлементаНаСервере(Знач ИмяТипа)
	
	Узел = НайтиУзелПоИмениТипа(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Узел.Тип = Новый ОписаниеТипов();
	Узел.Представление = БазовоеПредставлениеКонтейнера(ИмяТипа);
	
КонецПроцедуры

&НаСервере
Процедура СнятьОтметкуКонтейнераНаСервере(Знач ИмяТипа)
	
	Узел = НайтиУзелПоИмениТипа(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Узел.Выбран = Ложь;
	Узел.Тип = Новый ОписаниеТипов();
	Узел.Представление = БазовоеПредставлениеКонтейнера(ИмяТипа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаЭлемента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		СнятьОтметкуКонтейнераНаСервере(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТипЭлементаНаСервере(ДополнительныеПараметры, Результат.ОписаниеТипов);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоГруппаУзла(Знач ИмяТипа)
	
	Возврат СтрНачинаетсяС(ИмяТипа, ПрефиксГруппы());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксГруппы()
	
	Возврат "Группа.";
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКвалификаторыПоУмолчанию()
	
	ЧислоРазрядность = 15;
	ЧислоМасштаб = 2;
	ЧислоТолькоПоложительное = Ложь;
	СтрокаДлина = 100;
	СтрокаФиксированнаяДлина = Ложь;
	ДатаЧастиДаты = "ДатаВремя";
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЧастейДаты()
	
	ПолеЧастейДаты = Элементы.ДатаЧастиДаты;
	
	Список = ПолеЧастейДаты.СписокВыбора;
	Список.Очистить();
	Список.Добавить("Дата", НСтр("ru = 'Дата'; en = 'Date'"));
	Список.Добавить("Время", НСтр("ru = 'Время'; en = 'Time'"));
	Список.Добавить("ДатаВремя", НСтр("ru = 'Дата и время'; en = 'Date and time'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКвалификаторов()
	
	Элементы.ГруппаКвалификаторыЧисла.Видимость = ТипОтмечен("Число");
	Элементы.ГруппаКвалификаторыСтроки.Видимость = ТипОтмечен("Строка");
	Элементы.ГруппаКвалификаторыДаты.Видимость = ТипОтмечен("Дата");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьКвалификаторовНаСервере()
	
	Элементы.ГруппаКвалификаторыЧисла.Видимость = ТипОтмеченНаСервере("Число");
	Элементы.ГруппаКвалификаторыСтроки.Видимость = ТипОтмеченНаСервере("Строка");
	Элементы.ГруппаКвалификаторыДаты.Видимость = ТипОтмеченНаСервере("Дата");
	
КонецПроцедуры

&НаСервере
Функция ТипОтмеченНаСервере(Знач ИмяТипа)
	
	Узел = НайтиУзелПоИмениТипа(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	
	Возврат Узел <> Неопределено И Узел.Выбран;
	
КонецФункции

&НаКлиенте
Функция ТипОтмечен(Знач ИмяТипа)
	
	Узел = НайтиУзелВДереве(ДеревоТипов.ПолучитьЭлементы(), ИмяТипа);
	
	Возврат Узел <> Неопределено И Узел.Выбран;
	
КонецФункции

&НаКлиенте
Функция НайтиУзелВДереве(Узлы, Знач ИмяТипа)
	
	Для Каждого Узел Из Узлы Цикл
		
		Если Узел.ИмяТипа = ИмяТипа Тогда
			Возврат Узел;
		КонецЕсли;
		
		НайденныйУзел = НайтиУзелВДереве(Узел.ПолучитьЭлементы(), ИмяТипа);
		Если НайденныйУзел <> Неопределено Тогда
			Возврат НайденныйУзел;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПодготовитьРезультатНаСервере()
	
	МассивТипов = Новый Массив;
	ТипыЭлементовКонтейнеров = Новый Соответствие;
	
	ТекстОшибки = СобратьВыбранныеТипы(ДеревоТипов.ПолучитьЭлементы(), МассивТипов, ТипыЭлементовКонтейнеров);
	Если ТекстОшибки <> Неопределено Тогда
		Возврат РезультатОшибки(ТекстОшибки);
	КонецЕсли;
	
	Если МассивТипов.Количество() = 0 Тогда
		Возврат РезультатОшибки(НСтр("ru = 'Не выбран ни один тип значений.'; en = 'No value type is selected.'"));
	КонецЕсли;
	
	ОшибкаКвалификаторов = ТекстОшибкиКвалификаторов();
	Если ОшибкаКвалификаторов <> Неопределено Тогда
		Возврат РезультатОшибки(ОшибкаКвалификаторов);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеТипов", Новый ОписаниеТипов(
		МассивТипов, КвалификаторыЧислаФормы(), КвалификаторыСтрокиФормы(), КвалификаторыДатыФормы()));
	Результат.Вставить("ТипыЭлементовКонтейнеров", ТипыЭлементовКонтейнеров);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СобратьВыбранныеТипы(Узлы, МассивТипов, ТипыЭлементовКонтейнеров)
	
	Для Каждого Узел Из Узлы Цикл
		
		ТекстОшибки = СобратьВыбранныеТипы(Узел.ПолучитьЭлементы(), МассивТипов, ТипыЭлементовКонтейнеров);
		Если ТекстОшибки <> Неопределено Тогда
			Возврат ТекстОшибки;
		КонецЕсли;
		
		Если НЕ Узел.Выбран Или ЭтоГруппаУзла(Узел.ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипУзла = ТипПоИмени(Узел.ИмяТипа);
		Если ТипУзла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТипов.Добавить(ТипУзла);
		
		Если НЕ Узел.ЭтоКонтейнер Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТипаЭлемента = ОписаниеТипаЭлементаУзла(Узел);
		Если ОписаниеТипаЭлемента = Неопределено Тогда
			Возврат НСтр("ru = 'Для выбранного контейнера не указан тип значений элементов.'; en = 'The element value type is not specified for the selected container.'");
		КонецЕсли;
		
		ТипыЭлементовКонтейнеров.Вставить(ТипУзла, ОписаниеТипаЭлемента);
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ОписаниеТипаЭлементаУзла(Узел)
	
	Если Узел.Тип = Неопределено Или Узел.Тип.Типы().Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Узел.Тип;
	
КонецФункции

&НаСервере
Функция КвалификаторыЧислаФормы()
	
	ЗнакЧисла = ДопустимыйЗнак.Любой;
	Если ЧислоТолькоПоложительное Тогда
		ЗнакЧисла = ДопустимыйЗнак.Неотрицательный;
	КонецЕсли;
	
	Возврат Новый КвалификаторыЧисла(ЧислоРазрядность, ЧислоМасштаб, ЗнакЧисла);
	
КонецФункции

&НаСервере
Функция КвалификаторыСтрокиФормы()
	
	ВидДлиныСтроки = ДопустимаяДлина.Переменная;
	Если СтрокаФиксированнаяДлина Тогда
		ВидДлиныСтроки = ДопустимаяДлина.Фиксированная;
	КонецЕсли;
	
	Возврат Новый КвалификаторыСтроки(СтрокаДлина, ВидДлиныСтроки);
	
КонецФункции

&НаСервере
Функция КвалификаторыДатыФормы()
	
	Возврат Новый КвалификаторыДаты(ЧастиДатыПоИмени(ДатаЧастиДаты));
	
КонецФункции

&НаСервере
Функция ТекстОшибкиКвалификаторов()
	
	Если ТипОтмеченНаСервере("Число") Тогда
		
		Если ЧислоРазрядность < 1 Или ЧислоРазрядность > 38 Тогда
			Возврат НСтр("ru = 'Разрядность числа должна быть в диапазоне от 1 до 38.'; en = 'Number precision must be in the range from 1 to 38.'");
		КонецЕсли;
		
		Если ЧислоМасштаб < 0 Или ЧислоМасштаб > ЧислоРазрядность Тогда
			Возврат НСтр("ru = 'Количество знаков дробной части должно быть в диапазоне от 0 до разрядности числа.'; en = 'The number of decimal places must be in the range from 0 to the number precision.'");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипОтмеченНаСервере("Строка") Тогда
		
		Если СтрокаДлина < 1 Или СтрокаДлина > 1048576 Тогда
			Возврат НСтр("ru = 'Длина строки должна быть в диапазоне от 1 до 1048576 символов.'; en = 'String length must be in the range from 1 to 1048576 characters.'");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеКонтейнера(Знач ИмяТипа, ОписаниеТипаЭлемента)
	
	Возврат БазовоеПредставлениеКонтейнера(ИмяТипа) + " ("
		+ НСтр("ru = 'элемент'; en = 'element'") + ": " + ПредставлениеОписанияТипов(ОписаниеТипаЭлемента) + ")";
	
КонецФункции

&НаСервереБезКонтекста
Функция БазовоеПредставлениеКонтейнера(Знач ИмяТипа)
	
	Если ИмяТипа = "Массив" Тогда
		Возврат НСтр("ru = 'Массив'; en = 'Array'");
	КонецЕсли;
	
	Возврат НСтр("ru = 'Список значений'; en = 'Value list'");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеОписанияТипов(ОписаниеТипов)
	
	Представления = Новый Массив;
	
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Представления.Добавить(ПредставлениеТипаСКвалификаторами(ТипЗначения, ОписаниеТипов));
	КонецЦикла;
	
	Возврат СтрСоединить(Представления, ", ");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеТипаСКвалификаторами(ТипЗначения, ОписаниеТипов)
	
	Если ТипЗначения = Тип("Число") Тогда
		
		Представление = СтрШаблон(НСтр("ru = 'Число(%1,%2)'; en = 'Number(%1,%2)'"),
			ОписаниеТипов.КвалификаторыЧисла.Разрядность,
			ОписаниеТипов.КвалификаторыЧисла.РазрядностьДробнойЧасти);
		
		Если ОписаниеТипов.КвалификаторыЧисла.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный Тогда
			Представление = Представление + " >= 0";
		КонецЕсли;
		
		Возврат Представление;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		
		Представление = СтрШаблон(НСтр("ru = 'Строка(%1)'; en = 'String(%1)'"), ОписаниеТипов.КвалификаторыСтроки.Длина);
		
		Если ОписаниеТипов.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная Тогда
			Представление = Представление + НСтр("ru = ', фиксированная'; en = ', fixed'");
		КонецЕсли;
		
		Возврат Представление;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Дата") Тогда
		
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат НСтр("ru = 'Дата'; en = 'Date'");
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат НСтр("ru = 'Время'; en = 'Time'");
		КонецЕсли;
		
		Возврат НСтр("ru = 'Дата и время'; en = 'Date and time'");
		
	КонецЕсли;
	
	Возврат Строка(ТипЗначения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТипПоИмени(Знач ИмяТипа)
	
	Если ПустаяСтрока(ИмяТипа) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Тип(ИмяТипа);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧастиДатыПоИмени(Знач Имя)
	
	Если Имя = "Дата" Тогда
		Возврат ЧастиДаты.Дата;
	КонецЕсли;
	
	Если Имя = "Время" Тогда
		Возврат ЧастиДаты.Время;
	КонецЕсли;
	
	Возврат ЧастиДаты.ДатаВремя;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеОбъектаМетаданных(ОбъектМетаданных)
	
	Если НЕ ПустаяСтрока(ОбъектМетаданных.Синоним) Тогда
		Возврат ОбъектМетаданных.Синоним;
	КонецЕсли;
	
	Возврат ОбъектМетаданных.Имя;
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатОшибки(Знач ТекстОшибки)
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстОшибки", ТекстОшибки);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
